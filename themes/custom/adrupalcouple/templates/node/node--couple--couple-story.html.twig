{#
/**
 * @file
 * Couple Story entity render — node.couple, `couple_story` view mode.
 *
 * Renders the community-arc section (About §3 CoupleStory):
 *   - Community story prose (field_community_story → CKEditor text_long output)
 *   - Dual person faces side-by-side (field_couple → person:couple_faces)
 *   - Milestone list (field_milestone → ui_suite_daisyui:timeline_item)
 *
 * The outer §3 section heading ("Along the way, in the open" / "Por el camino,
 * en abierto") is a SEPARATE translatable LB text inline block placed at weight 0
 * in the LB section above this block (weight 1). This template is responsible only
 * for the CoupleStory body — not the h2 heading.
 *
 * Design contract (About §3):
 *   - Wrapper: mt-6 (CoupleStory offset from section heading above).
 *   - Story prose: rendered as CKEditor HTML inside .prose wrapper.
 *   - Faces: same flex layout as couple_hero (128px, rounded-full).
 *   - Milestones: DaisyUI timeline (timeline-vertical timeline-compact) via
 *     ui_patterns formatter — year in timeline-start, label in timeline-end.
 *
 * Available content:
 * - content.field_community_story Community arc prose (text_default formatter).
 * - content.field_couple          Two person:couple_faces atoms.
 * - content.field_milestone       Milestone timeline (ui_patterns formatter).
 *
 * @see template_preprocess_node()
 * @see node--couple--couple-hero.html.twig
 * @see node--person--couple-faces.html.twig
 */
#}
<div{{ attributes.addClass('couple-story-entity mt-6') }}>

  {# ── Faces FIRST (React CoupleStory order) — avatar (w-20) + name + role ──── #}
  {# inline, not the captioned-below couple_faces atom. couple_persons from
     adrupalcouple_preprocess_node__couple() (couple_story view mode). #}
  {% if couple_persons %}
    <div class="couple-faces flex flex-wrap items-center gap-4 mb-6">
      {% for person in couple_persons %}
        <div class="flex items-center gap-3">
          {% if person.avatar_url %}
            <div class="avatar">
              <div class="w-20 rounded-full">
                <img src="{{ person.avatar_url }}" alt="{{ person.name }}"
                     width="128" height="128" loading="lazy" decoding="async">
              </div>
            </div>
          {% else %}
            <div class="avatar avatar-placeholder">
              <div class="w-20 rounded-full bg-primary text-primary-content">
                <span aria-hidden="true" class="text-xl font-semibold">{{ person.initials }}</span>
                <span class="sr-only">{{ person.name }}</span>
              </div>
            </div>
          {% endif %}
          <div>
            <p class="font-heading text-lg font-semibold">{{ person.name }}</p>
            {% if person.role %}<p class="text-sm text-muted">{{ person.role }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# ── Community story prose (after the faces) ──────────────────────────────── #}
  {% if content.field_community_story|render|trim %}
    <div class="couple-story-body prose max-w-none mb-6">
      {{ content.field_community_story }}
    </div>
  {% endif %}

  {# ── Milestone timeline ──────────────────────────────────────────────────── #}
  {#
   * field_milestone is rendered via ui_patterns_component_per_item formatter
   * (ui_suite_daisyui:timeline_item). The formatter wraps each delta in a
   * timeline-item SDC. The ul.timeline wrapper below is provided by the
   * field formatter's own container template or by ui_suite_daisyui itself;
   * if the formatter does not add the outer ul, add it here.
   *
   * Year accent: text-primary font-semibold (teal — DaisyUI --color-primary).
   * Applied inside the timeline_item SDC's timeline-start cell via class on the
   * cell; override via ui_suite_daisyui template if needed.
   #}
  {% if content.field_milestone|render|trim %}
    <div class="couple-milestones mt-4">
      {{ content.field_milestone }}
    </div>
  {% endif %}

</div>
