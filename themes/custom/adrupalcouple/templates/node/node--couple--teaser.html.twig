{#
/**
 * @file node--couple--teaser.html.twig
 *
 * Couple node — teaser view mode (used in the couples_grid View listing).
 * Delegates rendering to the adrupalcouple:couples-card SDC.
 *
 * Variables provided by adrupalcouple_preprocess_node__couple() (adrupalcouple.theme):
 *   couple_persons — array of { name, avatar_url, initials } for up to 2 persons
 *   founding       — boolean, true when field_founding is set
 *   founding_label — t('Founding couple')
 *   story_excerpt  — body.summary or first 160 chars of body.value
 *   (couple_url comes from {{ url }} — standard node template variable)
 *
 * Heading hierarchy:
 *   h1 "Couples"        ← Section 1 (views-view--couples-grid--page-1.html.twig)
 *     h2 "Browse…"      ← Section 3 heading (same template)
 *       h3 couple name  ← couples_card SDC card-title (here)
 *
 * @see adrupalcouple.theme → adrupalcouple_preprocess_node__couple()
 * @see components/couples_card/couples_card.twig
 */
#}
{# Avatars rendered NATIVELY (media couple_faces view mode via drupal_entity),
   passed to the SDC as the `avatars` slot — no preprocess avatar URL. #}
{% set avatars %}
  {% for item in node.field_couple %}
    {% set person = item.entity %}
    {% if person %}
      {% set media = person.schema_image.entity %}
      {% if media %}
        <div class="avatar"><div class="rounded-full w-16 overflow-hidden">{{ drupal_entity('media', media.id, 'couple_faces') }}</div></div>
      {% else %}
        <div class="avatar avatar-placeholder"><div class="rounded-full bg-primary text-primary-content w-16"><span aria-hidden="true">{{ person.label|first|upper }}</span><span class="sr-only">{{ person.label }}</span></div></div>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endset %}

{# couple_name: node.label (string) — `label` is a render array → empty SDC prop. #}
{{ include('adrupalcouple:couples_card', {
  couple_name: node.label,
  couple_url: url,
  story_excerpt: story_excerpt,
  founding: founding,
  founding_label: founding_label,
  avatars: avatars,
}) }}
