{#
/**
 * @file
 * Couple profile display — node.couple, `full_article` view mode.
 *
 * Side-by-side faces (field_couple renders 2 person:token atoms), origin
 * story body, optional milestone timeline. No ceremony / section chrome.
 *
 * Conditional regions:
 * - field_milestone → DaisyUI timeline (UI Patterns ui_suite_daisyui:timeline_item).
 *
 * @see template_preprocess_node()
 */
#}
<article{{ attributes.addClass('couple-profile') }}>
  {% if content.field_couple|render|trim %}
    <div class="couple-faces flex gap-6 justify-center items-end mb-8">
      {{ content.field_couple }}
    </div>
  {% endif %}
  <div class="couple-story prose max-w-prose mx-auto px-4">
    <h1 class="couple-title">{{ label }}</h1>
    {{ content.body }}
  </div>
  {% if content.field_milestone|render|trim %}
    <div class="couple-milestones max-w-prose mx-auto px-4 mt-10">
      <ul class="timeline timeline-vertical">
        {{ content.field_milestone }}
      </ul>
    </div>
  {% endif %}
</article>
