{#
/**
 * @file
 * Couple Hero entity render — node.couple, `couple_hero` view mode.
 *
 * Renders the couple's title as <h1> and the two person face figures side-by-side
 * (field_couple → person:couple_faces). This output is consumed by the
 * block_content.couple_hero inline block, which wraps it and adds the
 * translated lede paragraph (field_lede) below.
 *
 * Design contract (About §1):
 *   - Couple title: <h1 class="font-heading …">
 *   - Faces: flex row, justify-center, gap-8 sm:gap-12; each is a
 *     node--person--couple-faces.html.twig figure (128px rounded-full).
 *   - No lede here — the enclosing block--inline-block--couple-hero.html.twig
 *     appends field_lede inside the .reading-column wrapper.
 *
 * Available content:
 * - label               Couple name (raw string — used directly for h1 text).
 * - content.field_couple Two person:couple_faces atoms.
 *
 * @see template_preprocess_node()
 * @see block--inline-block--couple-hero.html.twig
 */
#}
<div{{ attributes.addClass('couple-hero-entity') }}>
  {# ── Overlapping faces ───────────────────────────────────────────────────── #}
  {# React CoupleHero: two uncaptioned avatars (w-24) overlapping (-space-x-3),
     rendered BEFORE the name. couple_persons comes from
     adrupalcouple_preprocess_node__couple() (couple_hero view mode). #}
  {% if couple_persons %}
    <div class="couple-faces flex -space-x-3">
      {% for person in couple_persons %}
        {% if person.avatar_url %}
          <div class="avatar">
            <div class="w-24 rounded-full ring-2 ring-base-100">
              <img src="{{ person.avatar_url }}" alt="{{ person.name }}"
                   width="128" height="128" loading="lazy" decoding="async">
            </div>
          </div>
        {% else %}
          <div class="avatar avatar-placeholder">
            <div class="w-24 rounded-full ring-2 ring-base-100 bg-primary text-primary-content">
              <span aria-hidden="true" class="text-2xl font-semibold">{{ person.initials }}</span>
              <span class="sr-only">{{ person.name }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {# ── Couple name heading (after the faces, per React order) ───────────────── #}
  <h1 class="mt-4 font-heading text-4xl font-semibold">{{ node.label }}</h1>
</div>
