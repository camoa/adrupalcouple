{#
/**
 * @file node--page--full.html.twig
 *
 * node.page — `full` view mode.
 *
 * Home (node 36) and About (node 6) are composed ENTIRELY in Layout Builder:
 * inline blocks (masthead, couple_hero, couple_story_block, basic text blocks)
 * + the frontpage View block + ui_styles section backgrounds/spacing. This
 * template therefore carries NO hardcoded masthead / intro / section markup —
 * it simply renders {{ content }}, which is the Layout Builder composition.
 *
 * The Accessibility statement (alias /accessibility) is NOT Layout Builder; it
 * uses node--page--accessibility.html.twig (added by the suggestion alter).
 *
 * The standalone page-title block is suppressed for LB-composed pages by
 * adrupalcouple_preprocess_page() so the node title is not duplicated above the
 * composition (Home H1 = masthead field_tagline; About H1 = couple title).
 *
 * @see adrupalcouple_preprocess_page()
 * @see block--inline-block--masthead.html.twig
 * @see block--inline-block--couple-hero.html.twig
 * @see block--inline-block--couple-story-block.html.twig
 */
#}
<article{{ attributes.addClass('node node--type-page node--view-mode-full') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {{ content }}
</article>
