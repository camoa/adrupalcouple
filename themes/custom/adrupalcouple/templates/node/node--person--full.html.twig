{#
/**
 * @file
 * Person profile display — node.person, `full` view mode.
 *
 * Four-section editorial biography (template-driven, NOT Layout Builder).
 * Background alternation: base-100 → base-200 → base-100 → base-200.
 *
 * Field mapping (react spec → real Drupal):
 *   field_avatar  → schema_image (media reference; avatar_96 / avatar_64 from preprocess)
 *   field_bio     → body (text_with_summary; node.body.processed)
 *   field_role    → field_role (text plain; node.field_role.value)
 *   field_links   → schema_same_as (link field; person_links[] from preprocess)
 *   field_author_focus → field_author_focus (string; node.field_author_focus.value)
 *
 * Preprocess variables supplied by adrupalcouple_preprocess_node__person():
 *   avatar_96        — render array for 96px avatar (image_style adc_author_avatar_1x1_96)
 *   avatar_64        — render array for 64px compact avatar (image_style adc_author_avatar_1x1_64)
 *   person_links[]   — [{uri, title}] from schema_same_as
 *
 * S3 embeds the person_articles View block filtered by this node's NID.
 * S2 is suppressed when field_author_focus is empty.
 *
 * @see adrupalcouple_preprocess_node__person()
 * @see template_preprocess_node()
 */
#}
<div{{ attributes.addClass('node--person node--view-mode--full') }}>

  {# S1 — Person Story · bg-base-100 · weight 1 #}
  <section class="bg-base-100">
    <div class="reading-column py-12">
      <header data-component="person-hero" class="py-8">

        {# Row: avatar (96px) + name/role block #}
        <div class="flex flex-wrap items-center gap-4">
          {# Avatar #}
          <div class="avatar">
            {% if avatar_96 %}
              <div class="w-24 rounded-full overflow-hidden">
                {{ avatar_96 }}
              </div>
            {% else %}
              {# Initials fallback — DaisyUI placeholder avatar #}
              <div class="avatar placeholder">
                <div class="bg-neutral text-neutral-content w-24 rounded-full" role="img" aria-label="{{ node.label }}">
                  <span class="text-3xl" aria-hidden="true">{{ node.label|slice(0, 1)|upper }}</span>
                </div>
              </div>
            {% endif %}
          </div>

          {# Name + role #}
          <div>
            <h1 class="font-heading text-4xl font-semibold">{{ node.label }}</h1>
            {# text-muted gives 5.62:1 on base-100 (D2 fix; opacity-70 gave 2.87:1) #}
            {% if node.field_role.0.value|trim %}
              <p class="text-lg text-muted">{{ node.field_role.value }}</p>
            {% endif %}
          </div>
        </div>

        {# Bio prose #}
        {% if node.body.0.processed|trim %}
          <div class="reading-prose mt-4 max-w-prose">{{ node.body.processed }}</div>
        {% endif %}

        {# Links: btn-ghost pill buttons (S1 variant — NOT the S4 plain text links) #}
        {% if person_links %}
          <ul class="mt-4 flex flex-wrap gap-2">
            {% for link in person_links %}
              <li>
                <a href="{{ link.uri }}"
                   class="btn btn-ghost btn-sm transition-colors duration-150"
                   rel="me noopener noreferrer"
                   target="_blank">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </header>

      {# Jump link to S3 #}
      <p class="mt-2">
        <a href="#their-writing" class="link link-primary transition-colors duration-150">
          {{ 'Jump to writing'|t }}
        </a>
      </p>
    </div>
  </section>

  {# S2 — What This Author Writes About · bg-base-200 · weight 2
       Hidden when field_author_focus is empty (anti-pattern: do NOT fall back to body here). #}
  {% if node.field_author_focus.0.value|trim %}
    <section class="bg-base-200">
      <div class="reading-column py-12">

        <h2 class="font-heading text-2xl font-semibold">
          {{ 'What @name writes about'|t({'@name': node.label}) }}
        </h2>

        {# Compact author identity row #}
        <div class="mt-4 flex items-center gap-3">
          <div class="avatar">
            {% if avatar_64 %}
              <div class="w-16 rounded-full overflow-hidden">
                {{ avatar_64 }}
              </div>
            {% else %}
              <div class="avatar placeholder">
                <div class="bg-neutral text-neutral-content w-16 rounded-full" role="img" aria-label="{{ node.label }}">
                  <span class="text-xl" aria-hidden="true">{{ node.label|slice(0, 1)|upper }}</span>
                </div>
              </div>
            {% endif %}
          </div>
          <div class="leading-tight">
            <p class="font-heading text-xl font-semibold">{{ node.label }}</p>
            {# D2: text-muted gives 4.62:1 on base-200 (opacity-70 gave 2.79:1) #}
            {% if node.field_role.0.value|trim %}
              <p class="text-muted">{{ node.field_role.value }}</p>
            {% endif %}
          </div>
        </div>

        {# Focus body: editorial copy describing author's writing territory #}
        <p class="reading-prose mt-4">{{ node.field_author_focus.value }}</p>

      </div>
    </section>
  {% endif %}

  {# S3 — Their Writing / Article Stream · bg-base-100 · weight 3
       WIDER container (max-w-4xl) than reading column — card grid needs breathing room. #}
  <section id="their-writing" class="bg-base-100">
    <div class="mx-auto max-w-4xl px-5 py-12">
      <h2 class="font-heading text-2xl font-semibold">{{ 'Their writing'|t }}</h2>

      {% set articles = drupal_view('person_articles', 'block_1', node.id) %}
      {% set articles_output = articles|render|trim %}
      {% if articles_output %}
        {{ articles }}
      {% else %}
        <p class="reading-prose mt-4 max-w-prose">
          {{ 'Nothing published yet — check back soon.'|t }}
        </p>
      {% endif %}
    </div>
  </section>

  {# S4 — Quiet Contact Line (coda) · bg-base-200 · weight 4
       Plain link link-primary anchors separated by · — NOT btn-ghost pills (S1 distinction). #}
  <section class="bg-base-200">
    <div class="reading-column py-12">
      {# Contact line: warm sentence, under 22 words, sentence case, no em-dash, active voice. #}
      <p class="reading-prose">
        {{ 'Want to talk Drupal? Find @name below.'|t({'@name': node.label}) }}
      </p>

      {% if person_links %}
        <p class="mt-3">
          {% for link in person_links %}
            {% if not loop.first %}
              {# aria-hidden on separator — screen readers skip decorative mid-dot #}
              <span class="mx-2 opacity-40" aria-hidden="true">·</span>
            {% endif %}
            <a href="{{ link.uri }}"
               class="link link-primary transition-colors duration-150"
               rel="me noopener noreferrer"
               target="_blank">
              {{ link.title }}
            </a>
          {% endfor %}
        </p>
      {% endif %}
    </div>
  </section>

</div>
