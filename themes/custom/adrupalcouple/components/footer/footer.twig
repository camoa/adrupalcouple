{# footer.twig #}
{#
  Props:
    brand_name        (string, required)
    rights_text       (string, required)
    built_note        (string, required)
    writing_nav_label (string, required)
    about_nav_label   (string, required)
    additional_classes (string, optional, default '')
  Slots:
    writing_links  — rendered <a> link items for the Writing nav group
    about_links    — rendered <a> link items for the About nav group
#}

{%
  set outer_classes = [
    'mt-16',
    'border-t',
    'border-base-300',
    'bg-base-200',
    additional_classes|default(''),
  ]|filter(v => v is not empty)|join(' ')
%}

<footer
  data-component="footer"
  {{ attributes.addClass(outer_classes) }}
>
  {# Inner footer grid — DaisyUI `footer` primitive #}
  <div class="footer mx-auto max-w-5xl gap-10 px-4 py-12 text-base-content sm:footer-horizontal">

    {# Writing nav group (D1: distinct aria-label per nav) #}
    <nav aria-label="{{ writing_nav_label }}">
      <h2 class="footer-title">{{ writing_nav_label }}</h2>
      {{ writing_links }}
    </nav>

    {# About nav group (D1: distinct aria-label per nav) #}
    <nav aria-label="{{ about_nav_label }}">
      <h2 class="footer-title">{{ about_nav_label }}</h2>
      {{ about_links }}
    </nav>

    {# Brand note (D1: plain <div>, NOT <aside> — aside requires independently meaningful content) #}
    <div class="max-w-xs">
      <p class="font-heading text-base font-semibold">{{ brand_name }}</p>
      {# D2: text-muted gives 4.62:1 on base-200; opacity-80 was only 3.74:1 — DO NOT revert to opacity-* #}
      <p class="mt-1 text-sm text-muted">{{ rights_text }}</p>
    </div>

  </div>

  {# Copyright bar (D2: opacity-60 div removed; text-muted gives 4.62:1) #}
  <div class="mx-auto max-w-5xl px-4 pb-8 text-xs">
    <p class="text-muted">
      &copy; <span data-vrt-mask>{{ "now"|date("Y") }}</span> {{ brand_name }}. {{ built_note }}
    </p>
  </div>

</footer>
