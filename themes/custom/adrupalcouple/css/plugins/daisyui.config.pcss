/**
 * Import DaisyUI excluding DaisyUI reset.css as Tailwind already provide same mechanism (Preflight).
 * We exclude DaisyUI reset.css as it prevents style from base layer to be applied.
 *
 * themes: false — suppresses ALL 35 built-in DaisyUI themes.
 * Brand themes (adc-warm, adc-dark) are registered via @plugin "daisyui/theme" in css/themes/adc.pcss.css.
 */
@plugin "daisyui" {
  exclude: reset;
  themes: false;
  logs: false;
}
