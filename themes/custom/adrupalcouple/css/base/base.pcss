/**
 * Base typography defaults and global resets.
 * All font-family values reference @theme tokens defined in tailwind.config.pcss.
 * Values verbatim from design-system-tokens.yml §typography.
 */

@layer base {
  html {
    font-family: var(--font-body);
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-base-100);
    color: var(--color-base-content);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    line-height: 1.15;
    text-wrap: balance;
  }

  code,
  pre,
  kbd,
  samp {
    font-family: var(--font-mono);
  }

  /* extlink (contrib) appends an inline SVG icon after external links. Tailwind
   * Preflight sets `svg { display:block }`, which drops that icon onto its own
   * line. Restore inline flow so it hugs the end of the link text. Scoped
   * STRICTLY to extlink's own icon classes (extlink_class ext / mailto / tel) —
   * never bare `svg`, so no other icon is affected. Pairs with
   * extlink_prevent_orphan (config), which keeps the last word + icon together
   * via .extlink-nobreak. Overridden in the theme, never in contrib CSS. */
  svg.ext,
  svg.mailto,
  svg.tel {
    display: inline-block;
    vertical-align: baseline;
  }
}
