/**
 * Base typography defaults and global resets.
 * All font-family values reference @theme tokens defined in tailwind.config.pcss.
 * Values verbatim from design-system-tokens.yml §typography.
 */

@layer base {
  html {
    font-family: var(--font-body);
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    background-color: var(--color-base-100);
    color: var(--color-base-content);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    line-height: 1.15;
    text-wrap: balance;
  }

  code,
  pre,
  kbd,
  samp {
    font-family: var(--font-mono);
  }
}
