/**
 * Navigation bar styles (task §4.5, authored as .pcss per G-CONV-28).
 *
 * Glyphs are Unicode text nodes only (no icon library):
 *   ☀ U+2600 / ☾ U+263E theme toggle, ☰ U+2630 mobile hamburger.
 * Light/dark is a DaisyUI theme concern (data-theme); these rules only own
 * the structural chrome and the front-page transparency rhythm.
 */

@layer components {
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-base-100);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1rem;
    height: 3.5rem;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--color-base-content);
    text-decoration: none;
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-base-content);
  }

  .nav-mobile-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-base-content);
  }

  @media (min-width: 768px) {
    .nav-mobile-toggle {
      display: none;
    }
  }

  /* Front page: nav sits flush above the masthead; give the page top breathing
     room so the first LB section isn't tucked under the sticky bar. */
  .site-main--front {
    padding-block-start: 0;
  }

  /* Brand logo (site-branding block): constrain to the navbar height — the SVG
     would otherwise render at its intrinsic ~228×156 and blow up the bar. */
  #block-adrupalcouple-site-branding img {
    height: 2.25rem;
    width: auto;
  }

  /* Dark mode: the logo is a fixed grayscale mark (dark shape + white "ac"
     letters). Inverting it flips ONLY light↔dark (no hue, it's grayscale):
     shape → light, letters → dark — so it stays visible on the dark header and
     the "ac" is preserved. (An external-SVG <img> can't be recolored by fills.) */
  [data-theme="adc-dark"] #block-adrupalcouple-site-branding img {
    filter: invert(1);
  }
}

/* Language switcher (EN/ES join): the active language fills btn-primary.
   `is-active` is added at render by set_active_class, so it can't be a
   template-time utility — this maps that state to the React active fill.
   UNLAYERED on purpose: DaisyUI `.btn` lives in @layer components and would
   otherwise out-cascade a same-layer rule (same precedence quirk as a11y.pcss). */
.language-link.is-active {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-primary-content);
}
