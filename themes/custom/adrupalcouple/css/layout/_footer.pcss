/**
 * Footer region styles (task §4.6, authored as .pcss per G-CONV-28).
 * Pairs with the `footer` SDC component.
 */

@layer components {
  .site-footer {
    background-color: var(--color-base-200);
    padding: 3rem 1rem;
    margin-top: auto;
    font-size: 0.875rem;
    color: oklch(var(--color-base-content) / 0.6);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }
}
