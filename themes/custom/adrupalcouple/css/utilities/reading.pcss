/**
 * Brand layout primitives — reading column and prose rhythm.
 * From design-system-tokens.yml §density / component-palette.
 */

@layer components {
  /* Reading column — 68ch measure (Bringhurst; design-system §density / component-palette #3) */
  .reading-column {
    max-inline-size: 68ch;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  /* Article prose rhythm: ≥17px body, 1.7 leading, generous spacing */
  .reading-prose {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .reading-prose > * + * {
    margin-block-start: 1.25rem;
  }

  .reading-prose h2 {
    font-size: 1.5rem; /* tokens.yml typography.scale.2xl */
    margin-block-start: 2.25rem;
  }

  .reading-prose h3 {
    font-size: 1.25rem; /* tokens.yml typography.scale.xl */
    margin-block-start: 1.75rem;
  }

  /* ── Article body field (CKEditor prose) ───────────────────────────────────
   * The body field renders as a wrapper <div class="article-body"> (see
   * field--node--body--article.html.twig). The `.reading-prose > * + *` owl
   * above only spaces DIRECT children of .reading-prose, so it stops at this
   * wrapper and never reaches the CKEditor <p> children. Re-apply the same
   * 1.25rem reading rhythm to the flow elements inside the body. (h2/h3/
   * blockquote/pre/figure are descendant-scoped above and already reach here.)
   * Value = density rhythm token (design-system-tokens.yml §density); matches
   * React ArticleBody `space-y-5`.
   * ──────────────────────────────────────────────────────────────────────── */
  .reading-prose .article-body > * + * {
    margin-block-start: 1.25rem;
  }

  /* In-body content links — clearly clickable: brand accent teal + underline.
   * Scoped to .article-body so the byline (.link link-hover) and topic chips
   * (.badge), which also live inside .reading-prose, keep their own treatment.
   * token: light.accent / dark.accent → --color-accent (teal.600 / teal.500). */
  .reading-prose .article-body a {
    color: var(--color-accent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness var(--duration-quick) var(--ease-standard);
  }

  .reading-prose .article-body a:hover {
    text-decoration-thickness: 2px;
  }

  .reading-prose .article-body a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-field);
  }

  /* Tailwind Typography (.prose) contexts — page / about / couple rich text.
   * Prose already underlines links; align the colour to the same brand accent
   * teal so in-body links read consistently across prose systems. */
  .prose a {
    color: var(--color-accent);
  }

  /* ── CKEditor 5 body field output ──────────────────────────────────────────
   * These selectors scope to .reading-prose so they only apply on the article
   * reading template. code-highlight.css (attached per-article via
   * hook_preprocess_node__article) covers .field--name-body equivalents with
   * identical values — both sets apply; code-highlight.css wins the cascade.
   * The .reading-prose variants below serve as the in-source truth and act as
   * a fallback if the library is not yet attached (e.g. block-rendered teasers).
   * ──────────────────────────────────────────────────────────────────────── */

  /* Pull-quote / blockquote — PullQuote.tsx brand spec (dusty-plum accent) */
  .reading-prose blockquote {
    margin-block: 2rem;
    border-inline-start: 4px solid var(--color-secondary);
    padding-inline-start: 1rem;
    font-family: var(--font-heading); /* Fraunces */
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.35;
    color: var(--color-secondary);
  }

  .reading-prose blockquote footer {
    margin-block-start: 0.5rem;
    font-family: var(--font-body); /* Atkinson Hyperlegible */
    font-size: 0.875rem;
    font-style: normal;
    color: var(--color-muted-content);
  }

  /* Honest code block — HonestCodeBlock.tsx / CKEditor 5 code-block plugin */
  .reading-prose pre {
    overflow-x: auto;
    border-radius: var(--radius-box);
    background-color: var(--color-neutral);
    padding: 1rem;
    font-size: 0.875rem;
    color: var(--color-neutral-content);
    margin-block: 2rem;
  }

  .reading-prose pre code {
    font-family: var(--font-mono); /* IBM Plex Mono */
    white-space: pre;
    background: none;
    padding: 0;
    border: none;
    color: inherit;
    font-size: inherit;
  }

  /* In-body evidential figures — InArticleFigure.tsx / core Media embed */
  .reading-prose figure {
    margin-block: 2rem;
  }

  .reading-prose figure img {
    height: auto;
    max-width: min(100%, 720px); /* 720px article-column max; overflow-x on container */
    border-radius: var(--radius-box);
    border: 1px solid var(--color-base-300);
  }

  .reading-prose figcaption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted-content);
  }
}
