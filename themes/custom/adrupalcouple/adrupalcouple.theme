<?php

/**
 * @file
 * Functions to support theming in the UI Suite DaisyUI theme.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_node__article().
 *
 * Attaches the code-highlight library to every article node render so that
 * CKEditor5 codeBlock output (<pre><code class="language-*">) gets the
 * ADrupalCouple honest-code highlighting palette (see js/code-highlight.js).
 */
function adrupalcouple_preprocess_node__article(array &$variables): void {
  $variables['#attached']['library'][] = 'adrupalcouple/code-highlight';
}
