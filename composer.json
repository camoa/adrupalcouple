{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/allowed_formats": "^3.0",
        "drupal/antibot": "^2.0",
        "drupal/auto_entitylabel": "^3.0",
        "drupal/brevo": "^1.0",
        "drupal/config_overlay": "^2.3",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/custom_field": "^3.0@RC",
        "drupal/devel": "^5.1",
        "drupal/dropdown_language": "^4.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/editoria11y": "^2.1",
        "drupal/entity_browser": "^2.9",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/field_group": "^4",
        "drupal/fivestar": "3.0.x-dev@dev",
        "drupal/focal_point": "^2.0",
        "drupal/geolocation": "4.x-dev@dev",
        "drupal/gin": "^5",
        "drupal/gin_toolbar": "^3",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.2",
        "drupal/hreflang": "^1.14",
        "drupal/http_cache_control": "^2.1",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/jquery_ui_draggable": "^2.1",
        "drupal/jsonapi_extras": "^3.26@beta",
        "drupal/klaro": "^3.0@RC",
        "drupal/layout_builder_styles": "^2.1",
        "drupal/layout_paragraphs": "^2.0",
        "drupal/link_attributes": "^2.1",
        "drupal/linkit": "^7.0@alpha",
        "drupal/manage_display": "3.x-dev@dev",
        "drupal/markdown_easy": "^1.0",
        "drupal/metatag": "^2.0",
        "drupal/metatag_ai": "^1.0",
        "drupal/moderation_dashboard": "^4",
        "drupal/moderation_sidebar": "^1.7",
        "drupal/node_read_time": "^1.15",
        "drupal/paragraphs": "^1.15",
        "drupal/pathauto": "^1.11",
        "drupal/purge": "^3.5",
        "drupal/redirect": "^1.9",
        "drupal/redirect_404": "^1.9",
        "drupal/robotstxt": "^1.6",
        "drupal/schema_metatag": "^3.0",
        "drupal/schemadotorg": "1.0.x-dev@dev",
        "drupal/search404": "^2.2@RC",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3",
        "drupal/seo_checklist": "^5.2",
        "drupal/simple_sitemap": "^4.1",
        "drupal/sitemap": "^2.0",
        "drupal/smart_date": "^4.0",
        "drupal/smtp": "^1.4",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/twig_tweak": "^3.4",
        "drupal/ui_suite_daisyui": "^5.0@alpha",
        "drupal/upgrade_status": "^4.3",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/yoast_seo": "^2",
        "drush/drush": "^13",
        "oomphinc/composer-installers-extender": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            },
            "file-mapping": {
                "[web-root]/sites/default/default.settings.php": false,
                "[web-root]/.htaccess": false
            }
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/core": {
                "Issue 3387100: Missing config schema for core.base_field_override.*.*.* third_party_settings.content_translation": "https://git.drupalcode.org/project/drupal/-/merge_requests/4768.patch"
            }
        }
    }
}
