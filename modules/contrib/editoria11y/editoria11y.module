<?php

/**
 * @file
 * Editoria11y module file.
 */

use Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Link;
use Drupal\Core\Render\Element;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\editoria11y\Api;
use Drupal\Core\Entity\EntityChangedInterface;
use Drupal\layout_builder\OverridesSectionStorageInterface;

/**
 * Implements hook_ckeditor5_plugin_info_alter().
 */
function editoria11y_ckeditor5_plugin_info_alter(array &$plugin_definitions): void {
  // Hook only called if CK5 is installed, so no PHP errors from broken use.
  if (isset($plugin_definitions['ckeditor5_table'])) {
    $config = Drupal::config('editoria11y.settings');
    $header_config = $config->get('ck5_table_headers');
    if (!$header_config || $header_config === 'none') {
      return;
    }
    $headers = [];
    if ($header_config === 'both') {
      $headers['rows'] = 1;
      $headers['columns'] = 1;
    }
    elseif ($header_config === 'row') {
      $headers['rows'] = 1;
    }
    elseif ($header_config === 'column') {
      $headers['columns'] = 1;
    }
    $table_plugin_definition = $plugin_definitions['ckeditor5_table']->toArray();
    $table_plugin_definition['ckeditor5']['config']['table']['defaultHeadings'] = $headers;
    $plugin_definitions['ckeditor5_table'] = new CKEditor5PluginDefinition($table_plugin_definition);
  }
}

/**
 * Implements hook_post_update().
 */
function editoria11y_hook_post_update(): void {
  if (!Drupal::state()->get('editoria11y.show_help_message')) {
    return;
  }
  $messenger = Drupal::messenger();

  $config_url = Url::fromRoute('editoria11y.settings');
  $config_link = Link::fromTextAndUrl(\Drupal::translation()->translate('Editoria11y config'), $config_url)->toString();

  $permissions_url = Url::fromRoute('user.admin_permissions');
  $permissions_link = Link::fromTextAndUrl(\Drupal::translation()->translate('confirm editor roles have permission'), $permissions_url)->toString();

  $messenger->addStatus(
    \Drupal::translation()->translate('Please remember to set up @config for live editing, and @permissions to "View Editoria11y Checker"', [
      '@config' => $config_link,
      '@permissions' => $permissions_link,
    ]));
}

/**
 * Implements hook_form_alter().
 *
 * The exposed date filters on dashboard views are defined with
 * `value.type: date`, which Views renders as an HTML5 `<input type="date">`
 * (day-only). On some sites a contrib module or field-type mismatch swaps
 * the widget to `datetime-local`, exposing hour/minute/second inputs with
 * no use case. Force the exposed widgets back to day-only whenever they
 * belong to our views, so the granularity matches the stored data.
 */
function editoria11y_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!str_starts_with($form_id, 'views_exposed_form')) {
    return;
  }
  $view = $form_state->get('view');
  if (!$view || !in_array($view->id(), ['ed11y_result', 'ed11y_action', 'ed11y_export', 'ed11y_crawler'], TRUE)) {
    return;
  }
  _editoria11y_force_date_only($form);
}

/**
 * Recursively rewrites datetime-local inputs to plain HTML5 date inputs.
 */
function _editoria11y_force_date_only(array &$element): void {
  if (isset($element['#type']) && $element['#type'] === 'datetime-local') {
    $element['#type'] = 'date';
    unset($element['#date_time_element'], $element['#date_time_format']);
  }
  foreach (Element::children($element) as $child) {
    _editoria11y_force_date_only($element[$child]);
  }
}

/**
 * Implements template_preprocess_views_view()
 *
 * @param array $variables
 *   View settings.
 */
function editoria11y_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $views = ['ed11y_result', 'ed11y_action', 'ed11y_export'];
  if (in_array($view->id(), $views, TRUE)) {
    $variables['more']['#options']['attributes']['class'][] = 'button button--primary';
    $apiUrl = Url::fromRoute('editoria11y.api_report')->toString();
    if (Drupal::currentUser()->hasPermission('manage editoria11y results')) {
      $sessionUrl = Url::fromRoute('system.csrftoken')->toString();
      $variables['#attached']['drupalSettings']['editoria11y']['api_url'] = $apiUrl;
      $variables['#attached']['drupalSettings']['editoria11y']['purge_page_url'] = Url::fromRoute('editoria11y.api_purge_page')->toString();
      $variables['#attached']['drupalSettings']['editoria11y']['purge_dismissal_url'] = Url::fromRoute('editoria11y.api_purge_dismissals')->toString();
      $variables['#attached']['drupalSettings']['editoria11y']['session_url'] = $sessionUrl;
      $variables['#attached']['library'][] = 'editoria11y/editoria11y-dashboard';
      $variables['#attached']['drupalSettings']['editoria11y']['admin'] = Drupal::currentUser()->hasPermission('administer editoria11y checker');
    }
  }

  // Add a CSV export button to the footer of dashboard page displays. The
  // link re-executes this display server-side with the current filters, so
  // it follows any field or filter changes a site builder makes to the view.
  // The ed11y_export view is skipped: Views Data Export attaches its own
  // download button to those displays.
  $exportable = ['ed11y_result', 'ed11y_action'];
  if (in_array($view->id(), $exportable, TRUE)
    && $view->display_handler->getPluginId() === 'page'
    && !empty($view->result)
    && Drupal::currentUser()->hasPermission('manage editoria11y results')) {
    // getExposedInput() already strips the pager parameter, so the export
    // carries the on-screen exposed filters, click-sort state, and
    // query-parameter contextual filter defaults.
    $query = $view->getExposedInput();
    unset($query['view_args']);
    if (!empty($view->args)) {
      $query['view_args'] = $view->args;
    }
    $variables['footer']['editoria11y_csv_export'] = [
      '#type' => 'link',
      '#title' => t('Export CSV'),
      '#url' => Url::fromRoute('editoria11y.csv_export', [
        'view_id' => $view->id(),
        'display_id' => $view->current_display,
      ], ['query' => $query]),
      '#attributes' => ['class' => ['button', 'ed11y-csv-export']],
      '#weight' => 10,
    ];
  }

  if ($view->id() == 'ed11y_crawler') {
    $variables['#attached']['library'][] = 'editoria11y_csa/editoria11y-csa-crawler';
  }
}

/**
 * Implements hook_entity_predelete().
 *
 * Removes relevant records from DB.
 *
 * @throws \Drupal\editoria11y\Exception\Editoria11yApiException
 *   Delete hook failed.
 */
function editoria11y_entity_predelete(EntityInterface $entity): void {

  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  try {
    $id = $entity->id();
    $type = $entity->getEntityTypeId();

    if (is_numeric($id) && $id > 0) {

      $connection = Drupal::database();

      // ed11y_page.entity_type stores a human-readable label ("Basic page",
      // "Entity: User"), not the entity type id, so match on route_name,
      // which is recorded as a machine name (entity.{type}.{rel}). An entity
      // can have several page rows (translations, preserved query parameter
      // variants), so collect every matching pid.
      $pids = $connection->select('ed11y_page', 'p')
        ->fields('p', ['pid'])
        ->condition('entity_id', $id)
        ->condition('route_name', $connection->escapeLike("entity.$type.") . '%', 'LIKE')
        ->execute()
        ->fetchCol();

      if ($pids) {
        $connection->delete("ed11y_action")
          ->condition('pid', $pids, 'IN')
          ->execute();
        $connection->delete("ed11y_result")
          ->condition('pid', $pids, 'IN')
          ->execute();
        $connection->delete("ed11y_page")
          ->condition('pid', $pids, 'IN')
          ->execute();
      }

    }
  }
  catch (Throwable $e) {
    \Drupal::logger('Editoria11y')->error('Predelete failed: @error_message', ['@error_message' => $e->getMessage()]);
  }

}

/**
 * Implements hook_locale_translation_projects_alter().
 */
function editoria11y_locale_translation_projects_alter(&$projects) {
  $moduleName = 'editoria11y';
  // Get the absolute path to the module directory.
  $modulePath = \Drupal::service('extension.list.module')->getPath($moduleName);

  // Set the interface translation server pattern with the absolute path.
  $projects[$moduleName]['info']['interface translation server pattern'] = $modulePath . '/translations/%language.po';
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches Editoria11y library and config based on context.
 *
 * @throws \Drupal\editoria11y\Exception\Editoria11yApiException
 *   Page attachment failed.
 */
function editoria11y_page_attachments(array &$attachments): void {
  $attach = [];

  // Exit if user does not have "view" permission.
  $attachments['#cache']['contexts'][] = 'user.permissions';
  if (!Drupal::currentUser()->hasPermission('view editoria11y checker')) {
    return;
  }

  $attachments['#cache']['tags'][] = 'config:editoria11y.settings';

  try {
    // Determine which dismissals are permitted.
    // "Ignore" is a global toggle, "mark OK" is per-user.
    $config = Drupal::config('editoria11y.settings');

    // '3' = path_hash column + unique keys (editoria11y_update_9020). Keeping
    // the checker off until updates run prevents writes against the missing
    // column in the deploy → updatedb window.
    $db_version = Drupal::state()->get('editoria11y.db_version');
    if (empty($db_version) || $db_version !== '3') {
      if (Drupal::currentUser()->hasPermission('administer editoria11y checker')) {
        Drupal::messenger()->addWarning(
          \Drupal::translation()->translate('Editoria11y: database tables are out of date. Please run <a href=":url">database updates</a>.', [
            ':url' => Url::fromRoute('system.db_update')->toString(),
          ])
        );
      }
      return;
    }

    // Confirm this is a "view" (not edit) route, and set last-changed time.
    $sync = !$config->get('disable_sync');

    $attachments['#cache']['contexts'][] = 'url';

    $route_match = Drupal::routeMatch();
    $route_name = $route_match->getRouteName();

    // Block add/edit are the only Layout Builder routes the checker can
    // handle, and only when they render as a standalone page. The core
    // off-canvas dialog is an AJAX response, which never reaches
    // hook_page_attachments; in practice this means the iframe created by the
    // Layout Builder iFrame Modal module. Everything else is the builder UI
    // itself, which the checker does not yet support.
    $layout_builder_entity = NULL;
    if (str_starts_with($route_name, 'layout_builder.')) {
      if (!in_array($route_name, ['layout_builder.add_block', 'layout_builder.update_block'], TRUE)) {
        return;
      }
      // Core upcasts section_storage for us. Only "overrides" storage has a
      // content entity behind it; "defaults" edits a view display, which has
      // no page to attribute results to.
      $section_storage = $route_match->getParameter('section_storage');
      if (!$section_storage instanceof OverridesSectionStorageInterface) {
        return;
      }
      $layout_builder_entity = $section_storage->getContextValue('entity');
      if (!$layout_builder_entity instanceof ContentEntityInterface
        || !$layout_builder_entity->hasLinkTemplate('canonical')) {
        return;
      }
    }

    // Get languages.
    $attachments['#cache']['contexts'][] = 'languages';
    $languageManager = Drupal::languageManager();
    $language = $languageManager->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    // The interface/content language above drives which checker UI translation
    // the browser loads. The *stored* page language must instead be the
    // content's own language so the dashboard Views join can match
    // node_field_data.langcode (which is 'und' for language-neutral content).
    // Default to the negotiated language, then refine to the resolved entity's
    // langcode wherever the route maps to a content entity.
    $page_language = $language;

    $library = 'editoria11y/editoria11y';
    $attachments['#attached']['library'][] = $library;

    // Null or false unless both sync and permission are true.
    $allow_ok = $sync && Drupal::currentUser()->hasPermission('mark as ok in editoria11y');

    // Hiding can work via localStorage.
    $allow_hide = Drupal::currentUser()->hasPermission('mark as hidden in editoria11y');
    $view_reports = Drupal::currentUser()->hasPermission('manage editoria11y results');
    $entity_type = FALSE;
    $page_path = FALSE;
    $page_title = '';
    $entity_id = 0;
    $changed = 0;
    $dismissals = FALSE;
    $matched_node = FALSE;

    if ($route_name === 'entity.node.canonical') {
      // We can expect nodes to have a $changed value for smart loading.
      $matched_node = $route_match->getParameter('node');
      $changed = $matched_node->changed->value;
      $entity_id = $matched_node->id();
      $page_language = $matched_node->language()->getId();
    }
    elseif ($layout_builder_entity) {
      // The form shows one block, not the page, so new results must not be
      // reported — treat it like any other edit form. Dismissals are stored
      // against the entity whose layout is being edited, so what an editor
      // marks OK here carries over to the rendered page.
      $matched_node = $layout_builder_entity;
      $changed = $matched_node instanceof EntityChangedInterface ? $matched_node->getChangedTime() : 0;
      $page_language = $matched_node->language()->getId();
      $entity_type = _editoria11y_resolve_entity_type_label($matched_node);
      // The Layout Builder route is a derivative of the parent entity, so
      // store against that entity's canonical route and aliased path.
      // Anything else creates a second page record for the same content.
      $route_name = 'entity.' . $matched_node->getEntityTypeId() . '.canonical';
      $page_path = $matched_node->toUrl('canonical')->toString();
      $sync = $sync ? 'dismissals' : FALSE;
    }
    elseif (str_starts_with($route_name, 'view.')) {
      // Polite mode for views.
      // @todo figure out how to get view and media nice names
      $route_chunk = explode('.', $route_name);
      $entity_type = ucfirst($route_chunk[0]) . ": " . ucfirst(str_replace("_", " ", $route_chunk[1]));
    }
    elseif (str_contains($route_name, 'preview')) {
      // We load previews in assertive mode AND disable reporting new issues.
      $changed = Drupal::time()->getRequestTime();
      $sync = $sync ? 'dismissals' : FALSE;
      // State: $allow_ok = unchanged, $allow_hide = unchanged.
    }
    elseif (str_ends_with($route_name, '.add') ||
      str_ends_with($route_name, '.add_form') ||
      str_ends_with($route_name, '.form_add') ||
      str_ends_with($route_name, '_create')
    ) {
      // Add: Node. Add_form: blocks, terms. Form_add: forms. Create: users.
      // Disable reporting.
      $sync = 'disable';
      // Disable localStorage.
      $dismissals = [];
    }
    elseif (!str_ends_with($route_name, 'canonical')) {
      // Disable reporting new issues on edit and revisions.
      $sync = $sync ? 'dismissals' : FALSE;
      // State: $allow_ok = unchanged, $allow_hide = unchanged.
      if ($route_name === 'editoria11y.reports_dashboard') {
        $attachments['#attached']['library'][] = 'editoria11y/editoria11y-dashboard';
      }
    }

    if ($sync && $sync !== 'disable') {
      $entity = NULL;
      $request = Drupal::request();
      // Get extra dashboard data if we plan to sync information.
      if (($route = $route_match->getRouteObject()) && $route->getOption('parameters')) {
        // Determine if the current route represents an entity.
        $matched_entity = _editoria11y_resolve_route_entity($route_name, $route_match);
        if ($matched_entity) {
          $entity = $matched_entity;
          $entity_type = _editoria11y_resolve_entity_type_label($entity) ?: $entity_type;
          if (!$entity_id && $entity->id()) {
            $entity_id = $entity->id();
          }
          if ($entity instanceof ContentEntityInterface) {
            $page_language = $entity->language()->getId();
          }
        }
        // Get titles without service; it returns form name while editing.
        if (!$matched_node) {
          $matched_node = $route_match->getParameter('node');
        }
        if ($matched_node) {
          $entity_id = $matched_node->id();
          $page_title = $matched_node->label();
        }
        else {
          $matched_term = $route_match->getParameter('taxonomy_term');
          if ($matched_term) {
            $page_title = $matched_term->label();
            // Prefix vocabulary label (from entity loop) or machine name.
            $entity_type = "Taxonomy: " . ($entity_type ?: $matched_term->bundle());
            $entity_id = $matched_term->id();
          }
          else {
            $matched_user = $route_match->getParameter('user');
            if ($matched_user) {
              $page_title = $matched_user->label();
              if (!$entity_type) {
                $entity_type = "Entity: User";
              }
            }
          }
        }
        // Fall back to service for nonentities like admin routes.
        if (empty($page_title)) {
          $page_title = Drupal::service('title_resolver')->getTitle($request, $route);
        }
        // Render rich text titles.
        if (is_array($page_title)) {
          /** @var \Drupal\Core\Render\RendererInterface $renderer */
          $page_title = Drupal::service('renderer')->renderInIsolation($page_title);
        }
      }
      // For node preview routes, 'node_preview' is a temp-store UUID key rather
      // than an entity upcast, so the parameters block above is skipped. Load
      // the node being previewed so the canonical title and path are shared
      // with the live page record.
      if ($route_name === 'entity.node.preview') {
        $uuid = $route_match->getParameter('node_preview');
        $store = \Drupal::service('tempstore.private')->get('node_preview');
        $form_state = $store->get($uuid);
        if ($form_state) {
          $matched_node = $form_state->getFormObject()->getEntity();
          $entity = $matched_node;
          $entity_id = $matched_node->id() ?: 0;
          $page_title = $matched_node->label();
          $page_language = $matched_node->language()->getId();
        }
      }
      // No title available; use route name.
      if (empty($page_title)) {
        $page_title = $route_name;
      }

      if (!$entity_type) {
        // Bundleless entities.
        $route_chunk = explode('.', $route_name);
        if (count($route_chunk) > 1) {
          $entity_type = ucfirst($route_chunk[0]) . ": " . ucfirst(str_replace("_", " ", $route_chunk[1]));
        }
        else {
          $entity_type = ucfirst($route_name);
        }
      }

      // Get canonical aliased path, even on edit/preview routes.
      if (!$page_path && $entity instanceof ContentEntityInterface) {
        try {
          $page_path = $entity->toUrl('canonical')->toString();
        }
        catch (\Exception $e) {
          // Entity has no canonical route; fall through.
        }
      }
      if (!$page_path) {
        $page_path = Url::fromRoute('<current>')->toString();
      }
      if (!empty($config->get('preserve_params'))) {
        // Based on core "request->normalizeQueryString()"
        $query = $request->getQueryString();
        if ('' !== $query) {
          $parts = [];
          $order = [];
          $preserved_params = explode(',', $config->get('preserve_params') ?? '');
          foreach (explode('&', $query ?? '') as $param) {
            if ('' === $param || '=' === $param[0]) {
              // Ignore useless delimiters, e.g. "x=y&".
              // Also ignore pairs with empty value.
              continue;
            }
            $keyValuePair = explode('=', $param, 2);

            if (in_array($keyValuePair[0], $preserved_params, TRUE)) {
              // GET parameters submitted from a HTML form, encode spaces
              // as "+" by default
              // (as defined in enctype application/x-www-form-urlencoded).
              // PHP also converts "+" to spaces when filling the global _GET or
              // when using the function parse_str. We use urldecode and
              // then normalize to RFC 3986 with rawurlencode.
              $parts[] = isset($keyValuePair[1]) ? rawurlencode(urldecode($keyValuePair[0])) . '=' . rawurlencode(urldecode($keyValuePair[1])) : rawurlencode(urldecode($keyValuePair[0]));
              $order[] = urldecode($keyValuePair[0]);
            }
          }
          if (!empty($parts)) {
            array_multisort($order, SORT_ASC, $parts);
            $page_path .= "?" . implode('&', $parts);
          }
        }
      }
      $page_path = substr($page_path, 0, 1000);

      // Global dismissals.
      $attachments['#cache']['tags'][] = 'editoria11y:dismissals';
      // Local dismissals.
      $attachments['#cache']['tags'][] = Api::pathCacheTag($page_path);
      $attachments['#cache']['tags'][] = 'config:editoria11y.settings';

      // Get all dismissals for this page. We want all of OK and some of ignore.
      $results = Drupal::service('editoria11y.dismissals_on_page');
      if ($sync === 'dismissals') {
        $replace = '/\/edit$|\/preview$/';
        $page_path = preg_replace($replace, '', $page_path);
      }
      // Look up by the content's own language, not the negotiated UI
      // language: that is what the write path stores, and the two differ for
      // language-neutral (und/zxx) content.
      $result = $results->getDismissals($page_path, $page_language);
      $dismissals = [];
      $pid = FALSE;
      $has_hides = FALSE;
      foreach ($result as $record) {
        if (!$pid && isset($record->pid)) {
          $pid = $record->pid;
        }
        if ($record->action_type === "ok") {
          $dismissals[$record->result_key][$record->element_id] = "ok";
        }
        elseif ($record->action_type === "hide") {
          $has_hides = TRUE;
          if ($record->uid == Drupal::currentUser()->id()) {
            $dismissals[$record->result_key][$record->element_id] = "hide";
          }
        }
      }
      if ($has_hides) {
        // "Hide" dismissals are personal, so the attached settings vary by
        // user; without this context, users sharing a permission hash would
        // receive each other's hides from the page cache. Only pages that
        // have hide records pay the per-user cache penalty: writing the
        // first hide invalidates this page's dismissals cache tag, so an
        // entry cached without the context cannot go stale.
        $attachments['#cache']['contexts'][] = 'user';
      }
      $attach['pid'] = $pid;
      $attach['page_title'] = $page_title;
      $attach['allow_ok'] = $allow_ok;
      $attach['view_reports'] = $view_reports;
      $attach['dashboard_url'] = Url::fromRoute('editoria11y.reports_dashboard')->toString();
    }
    $attach['allow_hide'] = $allow_hide;

    // Runtime values derived from current route.
    // 'lang' selects the checker UI translation (viewer's language);
    // 'content_language' is the referenced entity's own langcode and is what
    // gets stored as ed11y_page.page_language for the dashboard Views join.
    $attach['lang'] = $language;
    $attach['content_language'] = $page_language;
    $attach['page_path'] = $page_path;
    $attach['entity_type'] = substr((string) $entity_type, 0, 32);
    $attach['entity_id'] = $entity_id;
    $attach['route_name'] = $route_name;
    $attach['changed'] = $changed;
    $attach['sync'] = $sync;
    $attach['dismissals'] = $dismissals;

    // Global runtime values. Each endpoint is attached as its own URL so the
    // JS never has to derive one route's path from another's.
    $attach['api_url'] = Url::fromRoute('editoria11y.api_report')->toString();
    $attach['dismiss_url'] = Url::fromRoute('editoria11y.api_dismiss')->toString();
    $attach['purge_page_url'] = Url::fromRoute('editoria11y.api_purge_page')->toString();
    $attach['session_url'] = Url::fromRoute('system.csrftoken')->toString();
    $attach['pepper'] = Drupal::service('keyvalue')->get('editoria11y')->get('pepper');
    $attach['version'] = Drupal::service('extension.list.module')->getExtensionInfo('editoria11y')['version'] ?? '0';
    /** @var \Drupal\Core\File\FileUrlGeneratorInterface $fileUrlGenerator */
    $fileUrlGenerator = Drupal::service('file_url_generator');
    $attach['css_url'] = $fileUrlGenerator
      ->generateString(Drupal::service('extension.list.module')->getPath('editoria11y'));
    // These two values are needed before the config API fetch so JS can
    // decide whether to load the library at all.
    $attach['no_load'] = $config->get('no_load');
    $attach['disable_live'] = $config->get('disable_live');

    // Global config is served from a cacheable API endpoint. The version
    // parameter changes when config, custom tests, or global dismissals
    // change, busting the browser cache.
    $config_version = Drupal::state()->get('editoria11y.config_version', 0);
    $attach['config_url'] = Url::fromRoute('editoria11y.api_config')->toString()
      . '?v=' . $config_version;

    // Allow other modules to alter the config we attach.
    $cacheMetadata = new CacheableMetadata();
    Drupal::moduleHandler()->invokeAll('editoria11y_alter_config', [&$attach, $cacheMetadata]);
    CacheableMetadata::createFromRenderArray($attachments)
      ->merge($cacheMetadata)
      ->applyTo($attachments);
    foreach ($attach as $key => $value) {
      $attachments['#attached']['drupalSettings']['editoria11y'][$key] = $value;
    }
  }
  catch (Throwable $e) {
    Drupal::logger('Editoria11y')->error('Page attachment failed: @error_message', ['@error_message' => $e->getMessage()]);
  }
}

/**
 * Resolves the canonical content entity for a route, if any.
 *
 * On entity.{type}.canonical routes the parameter named {type} is preferred
 * over other entity-typed parameters in the route. This matters for nested
 * entity URLs (e.g. entity.group_relationship.canonical at
 * /group/{group}/content/{group_relationship}) where iterating the route's
 * parameters option in declaration order would otherwise return the outer
 * {group} entity instead of the inner {group_relationship}.
 *
 * Falls back to the first entity-typed parameter on routes that don't follow
 * the entity.{type}.canonical naming convention.
 *
 * @return \Drupal\Core\Entity\ContentEntityInterface|null
 *   The matched entity, or NULL if the route has no usable entity parameter.
 */
function _editoria11y_resolve_route_entity(string $route_name, RouteMatchInterface $route_match): ?ContentEntityInterface {
  $route = $route_match->getRouteObject();
  if (!$route) {
    return NULL;
  }
  $parameters = $route->getOption('parameters');
  if (!$parameters) {
    return NULL;
  }

  $preferred = NULL;
  if (preg_match('/^entity\.([a-z0-9_]+)\.canonical$/', $route_name, $m)) {
    $candidate = $route_match->getParameter($m[1]);
    if ($candidate instanceof ContentEntityInterface && $candidate->hasLinkTemplate('canonical')) {
      $preferred = $candidate;
    }
  }

  foreach ($parameters as $name => $options) {
    if (!isset($options['type']) || !str_starts_with($options['type'], 'entity:')) {
      continue;
    }
    $candidate = $preferred ?: $route_match->getParameter($name);
    $preferred = NULL;
    if ($candidate instanceof ContentEntityInterface && $candidate->hasLinkTemplate('canonical')) {
      return $candidate;
    }
  }

  return NULL;
}

/**
 * Resolves a content entity to its bundle-entity label.
 *
 * @return string|null
 *   The bundle entity's label, or NULL if the entity type is bundleless or
 *   the bundle entity could not be loaded.
 */
function _editoria11y_resolve_entity_type_label(ContentEntityInterface $entity): ?string {
  $bundle_type_id = $entity->getEntityType()->getBundleEntityType();
  if (!$bundle_type_id) {
    return NULL;
  }
  $bundle_storage = Drupal::entityTypeManager()->getStorage($bundle_type_id);
  $bundle_entity = $bundle_storage->load($entity->bundle());
  return $bundle_entity ? (string) $bundle_entity->label() : NULL;
}
