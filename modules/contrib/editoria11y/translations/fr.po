msgstr "Ce champ possède‑t‑il une étiquette visible ?"

msgid "Prefer visible labels to placeholders"
msgstr "Préférer les étiquettes visibles aux textes de remplacement"

msgid "Is this reset button needed?"
msgstr "Ce bouton de réinitialisation est‑il nécessaire ?"

msgid "This input has an empty label"
msgstr "Ce champ a une étiquette vide"

msgid "Visible label does not match invisible label"
msgstr "L’étiquette visible ne correspond pas à l’étiquette invisible"

msgid "This image input is missing alt text"
msgstr "Ce champ image n'a pas de texte alternatif"

msgid "This input is not connected to a label"
msgstr "Ce champ n’est pas connecté à une étiquette"

msgid "Language tag does not match the content"
msgstr "La balise de langue ne correspond pas au contenu"

msgid "This content appears to be in a different language"
msgstr "Ce contenu semble être dans une autre langue"

msgid "This alt text appears to be in a different language"
msgstr "Ce texte alternatif semble être dans une autre langue"

msgid "Alt text used as a link should not be a URL"
msgstr "Un texte alternatif utilisé comme lien ne doit pas être une URL"

