msgstr "Alapértelmezett"

msgid "Node path"
msgstr "Node útvonala"

msgid "view"
msgstr "nézet"

msgid "Term path"
msgstr "Taxonómiaútvonal"

msgid "User bio path"
msgstr "Felhasználói bemutatkozás útvonala"

msgid "Term title"
msgstr "Taxonómiai cím"

