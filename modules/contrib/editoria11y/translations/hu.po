msgid_plural "@count"
msgstr[0] "@count"

msgid "Reset"
msgstr "Visszaállítás"

msgid ""
"<span class=\"ed11y-reset-dismissal\"><span class=\"ed11y-page-id\">{{ pid }}"
"</span><span class=\"ed11y-dismissal-id\">{{id}}</span></span>"
msgstr ""
"<span class=\"ed11y-reset-dismissal\"><span class=\"ed11y-page-id\">{{ pid }}"
"</span><span class=\"ed11y-dismissal-id\">{{id}}</span></span>"

msgid "››"
msgstr "››"

msgid "‹‹"
msgstr "‹‹"

msgid "- All -"
msgstr "- Összes -"

msgid "Offset"
msgstr "Eltolás"

msgid "« First"
msgstr "« Első"

msgid "Last »"
msgstr "Utolsó »"

msgid "Asc"
msgstr "Növekvő"

msgid "Desc"
msgstr "Csökkenő"

msgid "User who dismissed alert"
msgstr "A figyelmeztetést elutasító felhasználó"

msgid "pid"
msgstr "pid"

msgid "Node"
msgstr "Node"

msgid "Term"
msgstr "Taxonómiaelem"

msgid "User bio"
msgstr "Felhasználói bemutatkozás"

msgid "Dismissals page"
msgstr "Elutasítások oldala"

msgid ""
"{% set dynamic_path = view_node ~ view_taxonomy_term ~ view_user  %}{% if "
"dynamic_path is empty %}{% set dynamic_path = page_path %}{% endif %}\r\n"
"<a href=\"{{ dynamic_path }}\" data-ed1ref=\"{{pid}}\">{{ page_title }}</a>"
msgstr ""
"{% set dynamic_path = view_node ~ view_taxonomy_term ~ view_user  %}{% if "
"dynamic_path is empty %}{% set dynamic_path = page_path %}{% endif %}\r\n"
"<a href=\"{{ dynamic_path }}\" data-ed1ref=\"{{pid}}\">{{ page_title }}</a>"

msgid "Still on page"
msgstr "Még mindig az oldalon"

msgid "Reset filters"
msgstr "Szűrők törlése"

msgid "Issues marked as hidden or OK in Editoria11y."
msgstr "Az Editoria11y‑ben elrejtettnek vagy OK‑nak jelölt problémák."

msgid "Dismissals filtered by issue"
msgstr "Hiba szerinti elutasítások"

msgid "No dismissals match these filters."
msgstr "Nincs a szűrőknek megfelelő elutasítás."

msgid "All"
msgstr "Összes"

msgid "Dismissed alerts of type \"{{result_name}}\""
