msgstr ", "

msgid "Node title"
msgstr "Node címe"

msgid "User name"
msgstr "Felhasználó neve"

msgid "Recorded path"
msgstr "Rögzített útvonal"

msgid "Computed"
msgstr "Számított"

msgid ""
"{% set dynamic_path = view_node ~ view_taxonomy_term ~ view_user  %}{% if "
"dynamic_path is empty %}{% set dynamic_path = page_path %}{% endif %}\r\n"
"{% set dynamic_title = title ~ name_2 ~ name_1 %}{% if dynamic_title is "
"empty %}{% set dynamic_title = page_title %}{% endif %}\r\n"
"<a href=\"{{ dynamic_path }}\" data-ed1ref=\"{{pid}}\">{{ dynamic_title }}</"
"a>"
msgstr ""
"{% set dynamic_path = view_node ~ view_taxonomy_term ~ view_user  %}{% if "
"dynamic_path is empty %}{% set dynamic_path = page_path %}{% endif %}\r\n"
"{% set dynamic_title = title ~ name_2 ~ name_1 %}{% if dynamic_title is "
"empty %}{% set dynamic_title = page_title %}{% endif %}\r\n"
"<a href=\"{{ dynamic_path }}\" data-ed1ref=\"{{pid}}\">{{ dynamic_title }}</"
"a>"

msgid "Dismissed alert"
msgstr "Elutasított figyelmeztetés"

msgid "By"
msgstr "Ki által"

