msgstr "Vídeo, áudio, molduras"

msgid "Contrast"
msgstr "Contraste"

msgid "Forms"
msgstr "Formulários"

msgid "ARIA and focus"
msgstr "ARIA e foco"

msgid "Page metadata"
msgstr "Metadados da página"

