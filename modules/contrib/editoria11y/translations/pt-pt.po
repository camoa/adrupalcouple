msgstr "Não foi possível processar o pedido. Os detalhes foram registados no registo."

msgid "API request rejected: @message"
msgstr "Pedido de API rejeitado: @message"

msgid "API request failed: @message"
msgstr "Falha no pedido de API: @message"

msgid "Export pages with alerts"
msgstr "Exportar páginas com alertas"

msgid ""
"Install the Editoria11y Export Batch Processor module to download these "
"reports."
msgstr "Instale o módulo Editoria11y Export Batch Processor para descarregar estes relatórios."

msgid "Export results"
msgstr "Exportar resultados"

