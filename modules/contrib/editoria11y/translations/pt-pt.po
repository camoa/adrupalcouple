msgstr "HTML inválido: imagem dentro de ligação sem atributo alt"

msgid "This link target may be invalid"
msgstr "O destino desta ligação pode ser inválido"

msgid "Should this quote be a heading?"
msgstr "Esta citação deveria ser um cabeçalho?"

msgid "Has this document been tagged for screen readers?"
msgstr "Este documento está devidamente marcado para leitores de ecrã?"

msgid "Should this bold text be a heading?"
msgstr "Este texto a negrito deveria ser um cabeçalho?"

msgid "Should this have list formatting?"
msgstr "Isto deveria ser formatado como lista?"

msgid "Broken same-page link"
msgstr "Ligação interna quebrada"

msgid "Do not justify text"
msgstr "Evite justificar texto"

msgid "Nested interactive layout components"
msgstr "Componentes interativos aninhados"

msgid "Is there an alternative for this PDF?"
msgstr "Existe alternativa para este PDF?"

msgid "Text is too small"
msgstr "O texto está demasiado pequeno"

msgid "Large blocks of emphasized text are harder to read"
msgstr ""
"Blocos grandes de texto enfatizado (negrito/itálico) dificultam a leitura"

msgid "Do not use sub/superscript as visual formatting"
msgstr "Não utilize superíndice/subscrito apenas para efeito visual"

msgid "Only links should be underlined"
msgstr "Apenas ligações devem estar sublinhadas"

msgid "Is this uppercase text needed?"
msgstr "Este texto em maiúsculas é realmente necessário?"

msgid "Are there redundant words in this alt text?"
msgstr "Este texto alternativo contém palavras redundantes?"

msgid "Tabindex overrides interrupt the focus order"
msgstr "As substituições de tabindex interrompem a ordem de foco"

msgid "This header cell needs text"
msgstr "Esta célula de cabeçalho precisa de texto"

