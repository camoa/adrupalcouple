msgid "<strong>License expired.</strong> Expired on: @date"
msgstr "<strong>ライセンスの有効期限切れ。</strong>有効期限：@date"

msgid "<strong>License has expired.</strong>"
msgstr "<strong>ライセンスの有効期限が切れました。</strong>"

