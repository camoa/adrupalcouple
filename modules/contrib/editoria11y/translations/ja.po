msgid "Update page paths"
msgstr "ページパスを更新"

msgid ""
"Replaces recorded URLs for Nodes, Terms and Users with their current "
"canonical path. <br>@ReviewPaths (node/1?node=2) will not be updated."
msgstr ""
"ノード、ターム、ユーザーの記録された URL を現在の標準パスで置き換えます。"
"<br>@ReviewPaths（例：node/1?node=2）は更新されません。"

msgid "Risky deletions"
msgstr "リスクのある削除"

msgid "Delete records for paths with parameters (e.g., ?page=2)"
msgstr "パラメータ付きパス（例：?page=2）のレコードを削除"

