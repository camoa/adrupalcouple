msgstr "Giver denne alt‑tekst mening i linket?"

msgid "Can this linked alt text be shorter?"
msgstr "Kan denne alt‑tekst i linket være kortere?"

msgid "This linked image needs alt text"
msgstr "Dette billede, som bruges som link, behøver alt‑tekst"

msgid "Does this linked image need a description?"
msgstr "Har dette linkede billede brug for en beskrivelse?"

msgid "Is this link actually a button?"
msgstr "Er dette link i virkeligheden en knap?"

msgid "Does this link open a new tab without warning?"
msgstr "Åbner dette link en ny fane uden advarsel?"

msgid "This linked alt text may be a placeholder"
msgstr "Denne linkede alt‑tekst kan være en pladsholder"

