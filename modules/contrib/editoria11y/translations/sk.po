msgstr "Nekontrolovať žiadny obsah počas jeho editovania"

msgid ""
"Use the \"Do not check on pages with these elements\" setting to prevent "
"checking only on specific pages. E.g., exclude: <code><em>form[id^=\"node-"
"article\"]</em></code>."
msgstr ""
"Nastavenie „Nekontrolovať na stránkach s týmito prvkami\" použite na "
"zabránenie kontroly iba na konkrétnych stránkach. Napr. vylúčte: "
"<code><em>form[id^=\"node-article\"]</em></code>."

msgid "Assign headers to CKEditor tables on insert"
msgstr "Priradiť záhlavie tabuľkám CKEditor pri vkladaní"

