msgstr "Blok: Najczęstsze alerty"

msgid "Most Frequent Editoria11y Alerts"
msgstr "Najczęstsze alerty Editoria11y"

msgid "Editoria11y - Most frequent alerts"
msgstr "Editoria11y – Najczęstsze alerty"

msgid "Alerts on specified page"
msgstr "Alerty na określonej stronie"

msgid ""
