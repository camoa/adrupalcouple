msgstr "ID 속성이 중복되어 있습니다"

msgid "This link has a tooltip with the same text as the link"
msgstr "이 링크에 링크 텍스트와 동일한 내용의 툴팁이 있습니다"

msgid "Does this audio have a transcript?"
msgstr "이 오디오에 텍스트 대본이 있나요?"

msgid "Is this visualization accessible?"
msgstr "이 시각화 자료는 접근 가능한가요?"

msgid "Embedded iframes need manual checks"
msgstr "삽입된 iframe은 수동 검토가 필요합니다"

msgid "Frame missing \"title\" attribute"
msgstr "프레임에 \"title\" 속성이 없습니다"

msgid "Frame with tabindex=\"-1\" will not be keyboard accessible."
msgstr "tabindex=\"-1\"인 프레임은 키보드로 접근할 수 없습니다."

msgid "Is this video accurately captioned?"
msgstr "이 동영상에 정확한 자막이 있나요?"

msgid "This heading has no text"
msgstr "이 제목에 텍스트가 없습니다"

msgid "This image is used as a heading, so it needs alt text"
msgstr "이 이미지가 제목으로 사용되고 있으므로 대체 텍스트가 필요합니다"

msgid "The first heading on this page is a subheading"
msgstr "이 페이지의 첫 번째 제목이 하위 제목입니다"

msgid "Can this heading be shorter?"
msgstr "이 제목을 더 짧게 할 수 있나요?"

msgid "This page is missing a Heading 1"
msgstr "이 페이지에 제목 1이 없습니다"

msgid "This heading is tagged at the wrong level"
msgstr "이 제목의 수준이 잘못 지정되어 있습니다"

msgid "This heading is unpronounceable"
msgstr "이 제목은 발음할 수 없습니다"

msgid "This element cannot be described by screen readers"
msgstr "이 요소는 스크린 리더가 설명할 수 없습니다"

msgid "Can this alt text be shorter?"
msgstr "이 대체 텍스트를 더 짧게 할 수 있나요?"

msgid "Is this image actually meaningless?"
msgstr "이 이미지가 실제로 의미 없는 이미지인가요?"

msgid "Image in a carousel or gallery marked as decorative"
msgstr "캐러셀 또는 갤러리의 이미지가 장식용으로 표시되어 있습니다"

msgid "This captioned image has no alt text"
msgstr "이 캡션 이미지에 대체 텍스트가 없습니다"

msgid "Alt text should not be the same as caption text"
msgstr "대체 텍스트와 캡션 텍스트가 동일해서는 안 됩니다"

msgid "Is there a visible label for this field?"
msgstr "이 필드에 보이는 레이블이 있나요?"

msgid "Prefer visible labels to placeholders"
msgstr "자리 표시자 대신 보이는 레이블을 사용하세요"

msgid "Is this reset button needed?"
msgstr "이 초기화 버튼이 필요한가요?"

msgid "This input has an empty label"
msgstr "이 입력 필드의 레이블이 비어 있습니다"

msgid "Visible label does not match invisible label"
msgstr "보이는 레이블이 숨겨진 레이블과 일치하지 않습니다"

msgid "This image input is missing alt text"
msgstr "이 이미지 입력에 대체 텍스트가 없습니다"

msgid "This input is not connected to a label"
msgstr "이 입력 필드가 레이블과 연결되어 있지 않습니다"

msgid "Language tag does not match the content"
msgstr "언어 태그가 콘텐츠와 일치하지 않습니다"

msgid "This content appears to be in a different language"
msgstr "이 콘텐츠는 다른 언어로 작성된 것 같습니다"

msgid "This alt text appears to be in a different language"
msgstr "이 대체 텍스트는 다른 언어로 작성된 것 같습니다"

