msgstr "Ungültiges HTML: Bild im Link ohne Alt‑Attribut"

msgid "This link target may be invalid"
msgstr "Linkziel könnte ungültig sein"

msgid "Should this quote be a heading?"
msgstr "Sollte dieses Zitat eine Überschrift sein?"

msgid "Has this document been tagged for screen readers?"
msgstr "Wurde dieses Dokument für Screenreader ausgezeichnet?"

msgid "Should this bold text be a heading?"
msgstr "Sollte dieser fett gesetzte Text eine Überschrift sein?"

msgid "Should this have list formatting?"
msgstr "Sollte das als Liste formatiert sein?"

msgid "Broken same-page link"
msgstr "Defekter Link innerhalb derselben Seite"

msgid "Do not justify text"
msgstr "Text nicht im Blocksatz ausrichten"

msgid "Nested interactive layout components"
msgstr "Verschachtelte interaktive Layout‑Komponenten"

msgid "Is there an alternative for this PDF?"
msgstr "Gibt es eine Alternative zu diesem PDF?"

msgid "Text is too small"
msgstr "Text ist zu klein"

msgid "Large blocks of emphasized text are harder to read"
msgstr "Große Textblöcke mit Hervorhebung sind schwerer zu lesen"

msgid "Do not use sub/superscript as visual formatting"
msgstr "Hoch‑/Tiefstellung nicht als reine visuelle Formatierung verwenden"

msgid "Only links should be underlined"
msgstr "Nur Links sollten unterstrichen sein"

msgid "Is this uppercase text needed?"
msgstr "Ist dieser GROSSBUCHSTABENTEXT notwendig?"

msgid "Are there redundant words in this alt text?"
msgstr "Enthält dieser Alt‑Text redundante Wörter?"

msgid "Tabindex overrides interrupt the focus order"
msgstr "Tabindex‑Überschreibungen unterbrechen die Fokusreihenfolge"

msgid "This header cell needs text"
msgstr "Diese Tabellenkopfzelle benötigt Text"

msgid "This table has an invalid headers attribute"
msgstr "Diese Tabelle hat ein ungültiges „headers“‑Attribut"

msgid "This table needs a header row and/or column"
msgstr "Dieser Tabelle fehlen Kopfzeilen in Zeile und/oder Spalte"

msgid "Content headings should not be used inside tables"
msgstr "Inhaltsüberschriften gehören nicht in Tabellen"

msgid "Invalid HTML list"
msgstr "Ungültige HTML‑Liste"

