msgstr "Video, Audio, Frames"

msgid "Contrast"
msgstr "Kontrast"

msgid "Forms"
msgstr "Formulare"

msgid "ARIA and focus"
msgstr "ARIA und Fokus"

msgid "Page metadata"
msgstr "Seiten‑Metadaten"

