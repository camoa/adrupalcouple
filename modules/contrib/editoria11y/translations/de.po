msgid "Meta tag limits how much users can enlarge text"
msgstr "Meta‑Tag begrenzt die mögliche Textvergrößerung"

msgid "Meta tag automatically refreshes page"
msgstr "Meta‑Tag aktualisiert die Seite automatisch"

msgid "Meta tag prevents users from enlarging text"
msgstr "Meta‑Tag verhindert die Vergrößerung von Text"

msgid "Meta tag for page title missing"
msgstr "Meta‑Tag für den Seitentitel fehlt"

msgid "Invalid HTML: image has no alt attribute"
msgstr "Ungültiges HTML: Bild ohne Alt‑Attribut"

msgid "Invalid HTML: linked image missing alt attribute"
msgstr "Ungültiges HTML: verlinktes Bild ohne Alt‑Attribut"

