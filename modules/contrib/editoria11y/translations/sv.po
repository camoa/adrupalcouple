msgstr "Behöver denna länkade bild en beskrivning?"

msgid "Is this link actually a button?"
msgstr "Är denna länk egentligen en knapp?"

msgid "Does this link open a new tab without warning?"
msgstr "Öppnar denna länk en ny flik utan varning?"

msgid "This linked alt text may be a placeholder"
msgstr "Denna länkade alt-text kan vara en platshållare"

msgid "This link only contains generic words"
msgstr "Denna länk innehåller bara generiska ord"

