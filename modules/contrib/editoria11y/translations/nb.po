msgstr "Denne alt‑teksten ser ut til å være på et annet språk"

msgid "Alt text used as a link should not be a URL"
msgstr "Alternativ tekst brukt som lenke bør ikke være en URL"

msgid "This linked alt might not be clear and concise"
msgstr "Denne lenkede alt-teksten er kanskje ikke klar og konsis"

msgid "Linked images need pronounceable alt text"
msgstr "Bilder brukt som lenker må ha uttalbar alternativ tekst"

msgid "Manual check: link contains \"click here\""
msgstr "Manuell kontroll: lenken inneholder «klikk her»"

msgid "Link article titles, not DOI numbers"
msgstr "Lenk til artikkeltitler, ikke DOI‑numre"

msgid "This link contains no words"
msgstr "Denne lenken mangler tekst"

msgid "Link with invalid \"aria-labelledby\" attribute"
msgstr "Lenke med ugyldig «aria‑labelledby»‑attributt"

msgid "This link needs a label"
msgstr "Denne lenken trenger en etikett"

msgid "Link points to a file without warning"
msgstr "Lenken peker til en fil uten at det opplyses på forhånd"

msgid "Links with the same text link to different pages"
msgstr "Lenker med samme tekst peker til forskjellige sider"

msgid "Does this alt text describe the link or the image?"
msgstr "Beskriver denne alt‑teksten lenken eller bildet?"

msgid "Does this alt text make sense as part of this link?"
msgstr "Gir denne alternative teksten mening i denne lenkesammenhengen?"

msgid "Can this linked alt text be shorter?"
msgstr "Kan den alternative teksten for lenkebildet være kortere?"

msgid "This linked image needs alt text"
msgstr "Dette lenkebildet trenger alternativ tekst"

msgid "Does this linked image need a description?"
msgstr "Trenger dette lenkebildet en beskrivelse?"

msgid "Is this link actually a button?"
msgstr "Er denne lenken egentlig en knapp?"

msgid "Does this link open a new tab without warning?"
msgstr "Åpner denne lenken en ny fane uten advarsel?"

msgid "This linked alt text may be a placeholder"
msgstr "Denne lenkede alt‑teksten kan være en plassholder"

msgid "This link only contains generic words"
msgstr "Denne lenken inneholder bare generiske ord"

msgid "The purpose of this link is visually hidden"
msgstr "Formålet med denne lenken er visuelt skjult"

msgid "Does this image's alt describe the image or the link?"
msgstr "Beskriver denne alternative teksten bildet eller lenken?"

msgid "Are the symbols or emoji in this link meaningful?"
msgstr "Er symbolene eller emojiene i denne lenken meningsfulle?"

msgid "This link is unpronounceable"
msgstr "Denne lenken er ikke uttalebar"

msgid "Link text should not be a URL"
msgstr "Lenketekst bør ikke være en URL"

msgid "Meta tag for page language missing"
msgstr "Meta‑tagg for sidens språk mangler"

msgid "Did you mean a different language code?"
msgstr "Mente du en annen språkkode?"

msgid "Invalid language code"
msgstr "Ugyldig språkkode"

msgid "Page language may not match the content"
msgstr "Sidens språk stemmer kanskje ikke overens med innholdet"

msgid "Meta tag limits how much users can enlarge text"
msgstr "Meta‑tagg begrenser hvor mye brukerne kan zoome inn på tekst"

msgid "Meta tag automatically refreshes page"
msgstr "Meta‑tagg oppdaterer siden automatisk"

msgid "Meta tag prevents users from enlarging text"
msgstr "Meta‑tagg hindrer brukeren i å zoome inn på tekst"

msgid "Meta tag for page title missing"
msgstr "Meta‑tagg for sidetittel mangler"

msgid "Invalid HTML: image has no alt attribute"
msgstr "Ugyldig HTML: bilde uten alt‑attributt"

msgid "Invalid HTML: linked image missing alt attribute"
msgstr "Ugyldig HTML: bilde brukt som lenke uten alt‑attributt"

msgid "Invalid HTML: image in link missing alt attribute"
msgstr "Ugyldig HTML: bilde inne i lenke uten alt‑attributt"

msgid "This link target may be invalid"
msgstr "Lenkemålet kan være ugyldig"

msgid "Should this quote be a heading?"
msgstr "Bør dette sitatet være en overskrift?"

msgid "Has this document been tagged for screen readers?"
msgstr "Er dette dokumentet riktig tagget for skjermlesere?"

msgid "Should this bold text be a heading?"
msgstr "Bør denne uthevede teksten være en overskrift?"

msgid "Should this have list formatting?"
msgstr "Bør dette være formatert som en liste?"

msgid "Broken same-page link"
msgstr "Intern lenke fungerer ikke"

msgid "Do not justify text"
msgstr "Vennligst unngå fulljustering (tekst i begge marger)"

msgid "Nested interactive layout components"
msgstr "Nestede interaktive komponenter"

msgid "Is there an alternative for this PDF?"
msgstr "Finnes det et alternativ til denne PDF‑filen?"

msgid "Text is too small"
msgstr "Teksten er for liten"

msgid "Large blocks of emphasized text are harder to read"
msgstr "Store tekstblokker i fet/kursiv er vanskelige å lese"

msgid "Do not use sub/superscript as visual formatting"
msgstr ""
"Vennligst ikke bruk hevet eller senket skrift som ren visuell formatering"

msgid "Only links should be underlined"
msgstr "Kun lenker bør ha understreking"

msgid "Is this uppercase text needed?"
msgstr "Er denne teksten i store bokstaver nødvendig?"

msgid "Are there redundant words in this alt text?"
msgstr "Inneholder denne alternative teksten overflødige ord?"

msgid "Tabindex overrides interrupt the focus order"
msgstr "Tabindex‑overstyringer forstyrrer fokusrekkefølgen"

msgid "This header cell needs text"
msgstr "Denne tabelloverskriftscellen trenger tekst"

msgid "This table has an invalid headers attribute"
msgstr "Denne tabellen har et ugyldig «headers»‑attributt"

msgid "This table needs a header row and/or column"
msgstr "Denne tabellen mangler overskriftsrad og/eller kolonneoverskrifter"

msgid "Content headings should not be used inside tables"
msgstr "Innholdsoverskrifter bør ikke brukes inni tabeller"

msgid "Invalid HTML list"
msgstr "Ugyldig HTML‑liste"

msgid "Linked images"
msgstr "Lenkede bilder"

msgid "Text formatting"
msgstr "Tekstformatering"

msgid "Video, audio, frames"
msgstr "Video, lyd, rammer"

msgid "Contrast"
msgstr "Kontrast"

msgid "Forms"
msgstr "Skjemaer"

msgid "ARIA and focus"
msgstr "ARIA og fokus"

msgid "Page metadata"
msgstr "Sidemetadata"

msgid "The request could not be processed. Details have been logged."
msgstr "Forespørselen kunne ikke behandles. Detaljene er logget."

msgid "API request rejected: @message"
msgstr "API-forespørsel avvist: @message"

msgid "API request failed: @message"
msgstr "API-forespørsel mislyktes: @message"

msgid "Export pages with alerts"
msgstr "Eksporter sider med varsler"

msgid ""
"Install the Editoria11y Export Batch Processor module to download these "
"reports."
msgstr "Installer Editoria11y Export Batch Processor-modulen for å laste ned disse rapportene."

msgid "Export results"
msgstr "Eksporter resultater"

msgctxt "problems"
msgid "Top alerts"
msgstr "Viktigste problemer"

msgctxt "problems"
msgid "Pages with the most alerts"
msgstr "Sider med flest problemer"

msgid "Recent dismissals"
msgstr "Nylige avvisninger"

msgid ""
"Activate the <a href=\"@csa\">Editoria11y CSA submodule</a> to see developer "
"tests."
msgstr ""
"Aktiver <a href=\"@csa\">undermodulen Editoria11y CSA</a> for å se "
"utviklertester."

msgid "Include all parts of the page that contain your theme and content."
msgstr "Inkluder alle deler av siden som inneholder temaet og innholdet ditt."

msgid "Include all parts of the page that contain your editable content."
msgstr ""
"Inkluder alle deler av siden som inneholder det redigerbare innholdet ditt."

msgid "Exclude elements that show unhelpful, repetitive, or inaccurate alerts."
msgstr ""
"Ekskluder elementer som viser lite nyttige, gjentakende eller unøyaktige "
"varsler."

msgid ""
"<a href=\"@permissions\">Add permissions</a>, especially \"View Editoria11y "
"checker\" and \"Mark OK.\"</a>"
msgstr ""
"<a href=\"@permissions\">Tildel tillatelser</a>, særlig « View Editoria11y "
"checker » og « Mark OK ».</a>"

msgid ""
"If you need help: <a href=\"@config_guide\">Configuration Guide</a> | <a "
"href=\"@issue_queue\">Issue Queue</a> | <a href=\"@help\">Support contacts</"
"a>"
msgstr ""
"Hvis du trenger hjelp: <a href=\"@config_guide\">Konfigurasjonsveiledning</"
"a> | <a href=\"@issue_queue\">Saksliste</a> | <a "
"href=\"@help\">Støttekontakter</a>"

msgid "Autodetect"
msgstr "Automatisk gjenkjenning"

msgid "Only user-editable content"
msgstr "Kun brukerredigerbart innhold"

msgid "Other"
msgstr "Annet"

msgid "Parts of the page to test"
msgstr "Deler av siden som skal testes"

msgid "\"Autodetect\" selects:"
msgstr "«Automatisk gjenkjenning» velger:"

msgid "Other: specify regions to check for developer and content problems"
msgstr ""
"Annet: angi områder som skal sjekkes for utvikler- og innholdsproblemer"

msgid ""
"Provide CSS selectors. For many sites, the site theme is wrapped in "
"<code>.dialog-off-canvas-main-canvas</code> while editing."
msgstr ""
"Angi CSS-selektorer. For mange nettsteder er nettstedstemaet pakket inn i "
"<code>.dialog-off-canvas-main-canvas</code> under redigering."

msgid "Do not check for any errors inside these elements"
msgstr "Ikke se etter feil inne i disse elementene"

msgid "These parts of the page will be ignored entirely."
msgstr "Disse delene av siden vil bli helt ignorert."

msgid "match content settings"
msgstr "matcher innholdsinnstillingene"

msgid "Page regions with user-editable content"
msgstr "Sideområder med brukerredigerbart innhold"

msgid ""
"Default: <code><em>main</em></code><br>Provide <a target=\"_blank\" "
"href=\"https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/"
"Selectors\">CSS selectors</a>. Content authors will only see the alerts "
"within these parts of the page. Do not provide selectors that nest within "
"each other, or the inner content will be checked twice."
msgstr ""
"Standard: <code><em>main</em></code><br>Angi <a target=\"_blank\" "
"href=\"https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/"
"Selectors\">CSS‑velgere</a>. Innholdsredaktører ser bare varslene innenfor "
"disse delene av siden. Ikke bruk nestede velgere, ellers kontrolleres det "
"indre innholdet to ganger."

msgid ""
"Default: <code><em>main</em></code><br>Provide <a target=\"_blank\" "
"href=\"https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/"
"Selectors\">CSS selectors</a>. Do not provide selectors that nest within "
"each other, or the inner content will be checked twice."
msgstr ""
"Standard: <code><em>main</em></code><br>Angi <a target=\"_blank\" "
"href=\"https://developer.mozilla.org/en-US/docs/Learn/CSS/Building_blocks/"
"Selectors\">CSS‑velgere</a>. Ikke bruk nestede velgere, ellers kontrolleres "
"det indre innholdet to ganger."

msgid "Errors in these elements should only be shown to developers"
msgstr "Feil i disse elementene skal bare vises til utviklere"

msgid "Do not check for content errors inside these elements"
msgstr "Ikke se etter innholdsfeil inne i disse elementene"

msgid ""
"Content editors are not responsible for errors in these elements. <br>E.g.: "
"<code><em>#sidebar-menu a, .slide [aria-hidden=\"true\"]</em></code>."
msgstr ""
"Innholdsredaktører er ikke ansvarlige for feil i disse elementene. "
"<br>F.eks.: <code><em>#sidebar-menu a, .slide [aria-hidden=\"true\"]</em></"
"code>."

msgid "Roles that will see developer alerts"
msgstr "Roller som skal se utviklervarsler"

msgid ""
"All roles with the <a href=\":url\">View editoria11y checker</a> permission "
"see content alerts."
msgstr ""
"Alle roller med tillatelsen <a href=\":url\">View editoria11y checker</a> "
"ser innholdsvarsler."

msgid "Advanced settings"
msgstr "Avanserte innstillinger"

msgid "Assertiveness"
msgstr "Varslingsnivå"

msgid "Checker mode for content roles"
msgstr "Kontrollmodus for innholdsroller"

msgid "Start open if there are any alerts"
msgstr "Start åpen dersom det finnes varsler"

msgid "Start open if there are new alerts"
msgstr "Start åpen dersom det finnes nye varsler"

msgid "Start minimized"
msgstr "Start minimert"

msgid ""
"Choose when the control panel should open and show inline tips. \"Start open "
"if there are any alerts\" is recommended, as it helps tips get noticed over "
"time."
msgstr ""
"Velg når kontrollpanelet skal åpnes og vise tips. «Start åpen dersom det "
"finnes varsler» anbefales for å gjøre varsler mer synlige over tid."

msgid "Checker mode for developer roles"
msgstr "Visningsmodus for utviklervarsler"

msgid "Do not check any content while it is being edited"
msgstr "Ikke kontroller innhold mens det redigeres"

msgid ""
"Use the \"Do not check on pages with these elements\" setting to prevent "
"checking only on specific pages. E.g., exclude: <code><em>form[id^=\"node-"
"article\"]</em></code>."
msgstr ""
"Bruk innstillingen «Ikke kontroller sider som inneholder disse elementene» "
"for å unngå kontroll på bestemte sider. F.eks. ekskluder:"
"<br><code><em>form[id^=\"node-article\"]</em></code>."

msgid "Assign headers to CKEditor tables on insert"
msgstr "Tildel overskrifter ved innsetting av CKEditor‑tabeller"

msgid "First row"
msgstr "Første rad"

msgid "First column"
msgstr "Første kolonne"

msgid "Both"
msgstr "Begge"

msgid ""
"You will need to clear cache for changes to this setting to appear in "
"CKEditor."
msgstr ""
"Endringer i denne innstillingen krever tømming av hurtigbuffer for å tre i "
"kraft i CKEditor."

msgid "Theme compatibility"
msgstr "Temakompatibilitet"

msgid "Configuration tips"
msgstr "Konfigurasjonstips"

msgid ""
"If the checker <strong>toggle</strong> does not appear: make sure a z-"
"indexed or overflow-hidden element in your front-end theme is not hiding or "
"covering the <code><em>ed11y-element-panel</em></code> container, make sure "
"that any custom selectors in the \"Disable the scanner if these elements are "
"detected\" field are not present, and make sure that no JavaScript errors "
"are appearing in your <a href=\"https://developer.mozilla.org/en-US/docs/"
"Tools/Browser_Console\"> browser console</a>"
msgstr ""
"Hvis <strong>bryteren</strong> ikke vises: kontroller at ingen elementer med "
"z‑indeks eller overflow‑hidden i front-end‑temaet skjuler eller dekker "
"<code><em>ed11y-element-panel</em></code>. Kontroller også at tilpassede "
"velgere i feltet «Disable the scanner if these elements are detected» ikke "
"finnes på siden, og at det ikke vises JavaScript‑feil i <a href=\"https://"
"developer.mozilla.org/en-US/docs/Tools/Browser_Console\">nettleserkonsollen</"
"a>."

msgid ""
"If the checker toggle is present but <strong>not detecting</strong> errors, "
"or missing errors that should be flagged: check that your inclusions & "
"exclusion settings below are not missing or ignoring the elements. It is not "
"uncommon for homepages or views to insert editable content outside the "
"<code><em>main</em></code> element."
msgstr ""
"Hvis bryteren vises, men <strong>ikke oppdager</strong> feil, eller mangler "
"varsler som burde vært flagget: kontroller at innstillinger for inkludering "
"og ekskludering ikke utelater aktuelle elementer. Det er vanlig at forsider "
"og visninger plasserer redigerbart innhold utenfor <code><em>main</em></"
"code>."

msgid "Theme"
msgstr "Tema"

msgid "Sleek"
msgstr "Moderne"

msgid "Classic"
msgstr "Klassisk"

msgid "Dark"
msgstr "Mørk"

msgid "Do not check on pages with these elements"
msgstr "Ikke utfør kontroll på sider som inneholder disse elementene"

msgid ""
"Used to block checking on site sections or admin pages.<br>E.g. "
"<code><em>.content-type-example, .tabs__link[href=*\"edit\"]</em></code>."
msgstr ""
"Brukes for å blokkere kontroll i visse seksjoner av nettstedet eller på "
"adminsider.<br>F.eks.: <code><em>.content-type-"
"example, .tabs__link[href=*\"edit\"]</em></code>."

msgid "Hide all alerts on pages where these elements are not present"
msgstr "Skjul alle varsler på sider der disse elementene ikke finnes"

msgid ""
"Used to limit alerting to nodes where the user can edit something. Suggested "
"selectors:<br> <code><em>.contextual-region a[href*=\"/edit\"], .contextual-"
"region a[href*=\"/manage\"]</em></code>."
msgstr ""
"Brukes for å begrense varsler til noder der en bruker kan redigere noe. "
"Foreslåtte velgere:<br><code><em>.contextual-region a[href*=\"/"
"edit\"], .contextual-region a[href*=\"/manage\"]</em></code>."

msgid ""
"Set to the number of other themes or modules that will be <a href=\"https://"
"editoria11y.princeton.edu/configuration/#customtests\">injecting custom "
"result JS events</a>."
msgstr ""
"Angi antall temaer eller moduler som vil <a href=\"https://"
"editoria11y.princeton.edu/configuration/#customtests\">injisere "
"egendefinerte resultat‑hendelser i JS</a>."

msgid "Positioning"
msgstr "Plassering"

msgid "Don't show edit links on tips in these containers"
msgstr "Ikke vis redigeringslenker i tips innenfor disse beholderne"

msgid ""
"Tips show copies of the \"Edit\" and \"Layout\" links for nodes, users and "
"taxonomy terms. These links are not helpful on lists of content from remote "
"nodes.<br>Provide a comma-separated list of page sections of where these "
"links should not show, E.g.: <code><em>#sidebar-menu, .news-feed</em></code>."
"<br>To hide the links <strong>everywhere</strong>, set this field to an "
"asterisk (<code><em>*</em></code>).<br>To modify the links, <a "
"href=\"https://editoria11y.princeton.edu/configuration/#modify-tips\" "
"target=\"_blank\">use the ed11yPop event</a> in your theme JS."
msgstr ""
"Tips viser kopier av «Rediger»‑ og «Layout»‑lenkene for noder, brukere og "
"taksonomitermer. Disse er ikke nyttige i lister med eksternt innhold."
"<br>Angi en kommaseparert liste med seksjoner der lenkene ikke skal vises, "
"f.eks.: <code><em>#sidebar-menu, .news-feed</em></code>.<br>For å skjule "
"lenker <strong>overalt</strong>, sett feltet til en stjerne (<code><em>*</"
"em></code>).<br>For å endre lenkene, bruk <a href=\"https://"
"editoria11y.princeton.edu/configuration/#modify-tips\" "
"target=\"_blank\">ed11yPop‑hendelsen</a> i temaets JS."

msgid "Pin panel to..."
msgstr "Fest panelet til …"

msgid "Right"
msgstr "Høyre"

msgid "Left"
msgstr "Venstre"

msgid "Don't cover these other widgets"
msgstr "Ikke dekk over disse widgetene"

msgid ""
"Provide a comma-separated list of selectors for other things that appear in "
"the bottom right of the page. <br>If nothing is set, Editoria11y will "
"automatically slide left to accommodate <code><em>#klaro_toggle_dialog, "
"#klaro-cookie-notice .same-page-preview-dialog.ui-dialog-position-side</em></"
"code>."
msgstr ""
"Angi en kommaseparert liste over elementer som vises nederst til høyre på "
"siden.<br>Hvis ingenting er angitt, vil Editoria11y automatisk flyttes mot "
"venstre for å unngå konflikter med: <code><em>#klaro_toggle_dialog, #klaro-"
"cookie-notice .same-page-preview-dialog.ui-dialog-position-side</em></code>."

msgid "Elements with overflow hidden"
msgstr "Elementer med overflow:hidden"

msgid ""
"Sometimes buttons get drawn and visually truncated outside the bounds of a "
"positioned element. Provide a selector list."
msgstr ""
"Noen ganger tegnes knapper utenfor begrensningene av et posisjonert element "
"og blir visuelt avkuttet. Angi en liste med velgere."

msgid "Theme JS will handle revealing hidden tooltips inside these containers"
msgstr ""
"Temaets JavaScript vil håndtere visning av skjulte verktøytips i disse "
"beholderne"

msgid ""
"Editoria11y detects hidden tooltips and warns the user when they try to jump "
"to them from the panel. For elements on this list, Editoria11y will <a "
"href=\"https://itmaybejj.github.io/editoria11y/#dealing-with-alerts-on-"
"hidden-or-size-constrained-content\">dispatch a JS event</a> instead of a "
"warning, so custom JS in your theme can first reveal the hidden tip (e.g., "
"open an accordion or tab panel)."
msgstr ""
"Editoria11y oppdager skjulte verktøytips og advarer når brukeren forsøker å "
"gå til dem via panelet. For elementer i denne listen vil Editoria11y i "
"stedet <a href=\"https://itmaybejj.github.io/editoria11y/#dealing-with-"
"alerts-on-hidden-or-size-constrained-content\">utløse en JS‑hendelse</a>, "
"slik at tilpasset JS i temaet kan vise tipset først (f.eks. ved å åpne et "
"panel eller et fanesett)."

msgid "Detecting dynamic and shadow content"
msgstr "Oppdage dynamisk og skyggedom‑innhold"

msgid "Dynamically refresh if new content appears"
msgstr "Oppdater dynamisk når nytt innhold dukker opp"

msgid "Watch for changes anywhere on the page"
msgstr "Overvåk endringer hvor som helst på siden"

msgid "Only watch for changes to content containers present on load"
msgstr ""
"Overvåk bare endringer i innholdsbeholdere som er til stede ved lasting"

msgid "Do not watch for changes"
msgstr "Ikke overvåk endringer"

msgid ""
"Set to \"anywhere\" if changes are being missed, set to \"ignore\" if you "
"notice performance issues. Themes and modules can also call "
"<code>Drupal.Ed11y.refresh()</code> to refresh results."
msgstr ""
"Bruk «anywhere» dersom endringer ikke oppdages, og «ignore» dersom ytelsen "
"påvirkes negativt. Temaer og moduler kan også kalle "
"<code>Drupal.Ed11y.refresh()</code> for å oppdatere resultater."

msgid "Check inside these specific Web components"
msgstr "Kontroller inne i disse spesifikke webkomponentene"

msgid ""
"Provide selectors for elements with <a href='https://developer.mozilla.org/"
"en-US/docs/Web/Web_Components'>shadow DOM</a> you want tested. E.g.: "
"<code><em>my-fancy-accordion-widget, my-magical-slideshow</em></code>."
msgstr ""
"Angi velgere for elementer med <a href='https://developer.mozilla.org/en-US/"
"docs/Web/Web_Components'>shadow DOM</a> som skal kontrolleres. F.eks.: "
"<code><em>my-fancy-accordion-widget, my-magical-slideshow</em></code>."

msgid "Auto-detect any Web components"
msgstr "Oppdag webkomponenter automatisk"

msgid ""
"This is easier to configure than specifying components, but may slow test "
"runs on very complicated pages."
msgstr ""
"Dette er enklere enn å angi spesifikke komponenter, men kan redusere ytelsen "
"på svært komplekse sider."

msgid "Syncing results to reports"
msgstr "Synkroniserer resultater til rapporter"

msgid ""
"Remember that results only sync to the dashboard when viewing nodes. Results "
"shown while editing or viewing previews or revisions will not sync."
msgstr ""
"Husk at resultater kun synkroniseres til kontrollpanelet ved visning av "
"noder. Resultater i forhåndsvisning, redigering eller revisjon synkroniseres "
"ikke."

msgid "Remove redundant base url from URLs"
msgstr "Fjern overflødig basis‑URL fra adresser"

msgid ""
"Provide base URL (\"/mysite\") if your site is installed in a subdirectory. "
"Subdirectories tend to get duplicated (/mysite/mysite/mypage) and throw "
"errors from the API."
msgstr ""
"Angi basis‑URL («/mysite») dersom nettstedet er installert i en "
"underkatalog. Slike kataloger kan dupliseres (/mysite/mysite/mypage) og "
"forårsake API‑feil."

msgid "Preserve query parameters"
msgstr "Bevar spørringsparametere"

msgid ""
"The dashboard ignores most parameters: results for both /news?f=1 and /news?"
"f=2 will show up as just /news. Provide a comma separated list of parameters "
"that are meaningful, and should appear as separate pages in results."
msgstr ""
"Kontrollpanelet ignorerer de fleste parametere: både /news?f=1 og /news?f=2 "
"blir vist som /news. Angi en kommaseparert liste med parametere som skal "
"betraktes som egne sider."

msgid "Disable sync altogether"
msgstr "Deaktiver synkronisering helt"

msgid ""
"Syncing test results back to Drupal is required for the <a target=\"_blank\" "
"href=\"/admin/reports/editoria11y\">issue</a> and <a target=\"_blank\" "
"href=\"/admin/reports/editoria11y/dismissals\">dismissal</a> dashboards and "
"\"mark OK\" buttons."
msgstr ""
"Synkronisering tilbake til Drupal er nødvendig for <a target=\"_blank\" "
"href=\"/admin/reports/editoria11y\">problemoversikten</a>, <a "
"target=\"_blank\" href=\"/admin/reports/editoria11y/dismissals\">visningen "
"av avvisninger</a> og «marker OK»-funksjonen."

msgid "Heading outline position of editable content"
msgstr "Overskriftsnivå for redigerbart innhold"

msgid ""
"To check headings in CKEditor, Editoria11y needs to know what the first "
"heading level should be in this field. Body fields should generally be at "
"the h2 level."
msgstr ""
"For å kontrollere overskrifter i CKEditor må Editoria11y vite hvilket nivå "
"som skal være første overskrift. Brødtekstfelt bør som regel starte på h2."

msgid "H2 level fields (body content)"
msgstr "H2‑nivåfelt (brødtekst)"

msgid ""
"Body fields on nodes are preceded by an h1, and their heading outline should "
"start with an h2. Ideally set this for top-level body fields for each of "
"your content types, and set blocks and embedded nodes to h3 or h4.\n"
"        <br>Set all content types: <code><em>form[id^=\"node-\"] #edit-body-"
"wrapper .ck-content</em></code>\n"
"        <br>Set specific content types: <code><em>form[id^=\"node-\"] #edit-"
"body-wrapper .ck-content</em></code>\n"
"        <br>Set up for Gutenberg: <code><em>form[id^=\"node-\"] #edit-body-"
"wrapper .is-root-container</em></code>"
msgstr ""
"Brødtekstfelt i noder innledes med en h1, og strukturen deres bør starte på "
"h2. Ideelt sett konfigureres dette for toppnivåbrødtekst i alle "
"innholdstyper, og blokker eller innebygde noder settes til h3 eller h4."
"<br>For alle innholdstyper: <code><em>form[id^=\"node-\"] #edit-body-"
"wrapper .ck-content</em></code><br>For spesifikke innholdstyper: "
"<code><em>form[id^=\"node-\"] #edit-body-wrapper .ck-content</em></"
"code><br>For Gutenberg: <code><em>form[id^=\"node-\"] #edit-body-wrapper .is-"
"root-container</em></code>"

msgid "H3 level fields (blocks or paragraphs with separate titles)"
msgstr "H3‑nivåfelt (blokker eller avsnitt med egne titler)"

msgid ""
"Sometimes inline and layout builder blocks are grouped under an h2 from a "
"separate field, so their highest heading level should be h3."
msgstr ""
"Noen ganger grupperes inline‑blokker og layout builder‑blokker under en h2 "
"fra et annet felt; de bør da ha h3 som høyeste overskrift."

msgid "H4 level fields (deeply nested blocks or paragraphs)"
msgstr "H4‑nivåfelt (dypt nestede blokker eller avsnitt)"

msgid ""
"Sometimes inline and layout builder blocks are grouped under an h3 from a "
"separate field, so their highest heading level should be h4."
msgstr ""
"Noen ganger grupperes inline‑ og layout builder‑blokker under en h3 fra et "
"annet felt; de bør da ha h4 som øverste nivå."

msgid "Modify tests that usually detect content issues"
msgstr "Endre tester som vanligvis oppdager innholdsproblemer"

msgid "Modify tests that usually detect template or configuration issues"
msgstr "Endre tester som vanligvis oppdager mal‑ eller konfigurasjonsproblemer"

msgid "Do not check contrast for these elements"
msgstr "Ikke kontroller kontrast for disse elementene"

msgid ""
"Provide a comma-separated list of selectors for elements to ignore for all "
"users."
msgstr ""
"Angi en kommaseparert liste med velgere for elementer som skal ignoreres for "
"alle brukere."

msgid "Remind editor that content in these embeds needs manual review"
msgstr "Vis at innhold i disse innebyggingene må gjennomgås manuelt"

msgid ""
"Provide a comma-separated list of selectors you wish to flag for the editor, "
"e.g.: <code><em>.my-embedded-feed, #my-social-link-block</em></code>."
msgstr ""
"Angi en kommaseparert liste med velgere som skal flagges, f.eks.: "
"<code><em>.my-embedded-feed, #my-social-link-block</em></code>."

msgid ""
"Default settings should work with both <a href=\"https://www.drupal.org/"
"project/linkpurpose\" target=\"_blank\">Link Purpose Icons</a> and <a "
"target=\"_blank\" href=\"https://www.drupal.org/project/extlink\">External "
"Links</a>."
msgstr ""
"Standardinnstillingene fungerer både med <a href=\"https://www.drupal.org/"
"project/linkpurpose\" target=\"_blank\">Link Purpose Icons</a> og <a "
"target=\"_blank\" href=\"https://www.drupal.org/project/extlink\">External "
"Links</a>."

msgid "Remind the editor that these linked documents need a manual check"
msgstr "Påminn at disse lenkede dokumentene trenger manuell gjennomgang"

msgid ""
"Add or remove filetypes. Set to \"false\" to disable the test altogether. "
"Providing any value will override the default, which is "
"<code><em>a[href$='.pdf'], a[href*='.pdf?']</em></code>."
msgstr ""
"Legg til eller fjern filtyper. Sett verdien til «false» for å deaktivere "
"testen helt. Enhver verdi overstyrer standarden:"
"<br><code><em>a[href$='.pdf'], a[href*='.pdf?']</em></code>."

msgid "Remove elements that match these selectors before testing link text"
msgstr ""
"Fjern elementer som samsvarer med disse velgerne før lenketekst kontrolleres"

msgid ""
"Provide a CSS selector of elements your modules programmatically add to "
"links (usually external or open-in-new-window links), so they can be ignored "
"when the link text is checked for the \"link has no text\" and \"link text "
"is not meaningful\" tests.<br>E.g.: <code><em>.this, .that</em></code>"
msgstr ""
"Angi en CSS‑velger for elementer som modulene legger til lenker (vanligvis "
"eksterne lenker eller lenker som åpnes i nytt vindu), slik at disse "
"ignoreres ved test av «lenken har ingen tekst» og «lenketeksten er ikke "
"meningsfull».<br>F.eks.: <code><em>.this, .that</em></code>"

msgid "Remove these strings before testing link text"
msgstr "Fjern disse strengene før lenketekst kontrolleres"

msgid ""
"Provide a pipe-separated (\"|\") list of phrases your modules "
"programmatically add to links to hint a purpose (external, mail, phone, open-"
"in-new-window), so they can be ignored when the link text is checked for the "
"\"link has no text\" and \"link text is not meaningful\" tests; e.g.:  "
"<pre><code><em>(link is external)|(link sends email)</em></code></pre>"
msgstr ""
"Angi en liste av tekster, separert med «|», som modulene legger til lenker "
"(for å angi ekstern, e‑post, telefon, nytt vindu osv.), slik at de ignoreres "
"under testing av «lenken har ingen tekst» og «lenketeksten er ikke "
"meningsfull».<br>F.eks.:<pre><code><em>(lenken er ekstern)|(lenken sender "
"e‑post)</em></code></pre>"

msgid "Strings in links that indicate new tabs"
msgstr "Strenger i lenker som antyder at nytt vindu eller ny fane åpnes"

msgid ""
"Provide a pipe-separated list of phrases your site uses to warn users a link "
"opens in a new tab; e.g.:  <pre><code><em>new&nbsp;tab|new&nbsp;window|"
"external</em></code></pre>"
msgstr ""
"Angi en liste med fraser, separert med «|», som nettstedet bruker for å "
"indikere at en lenke åpner i ny fane; f.eks.:  <pre><code><em>ny&nbsp;fane|"
"nytt&nbsp;vindu|ekstern</em></code></pre>"

msgid ""
"Modules like Link Purpose or External Links can mark links automatically."
msgstr ""
"Moduler som Link Purpose eller External Links kan merke disse lenkene "
"automatisk."

