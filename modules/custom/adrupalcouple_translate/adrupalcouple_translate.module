<?php

/**
 * @file
 * AI bulk-translation support for A Drupal Couple.
 */

declare(strict_types=1);

use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_query_alter().
 *
 * Restricts the `untranslated_content` view to source nodes that do NOT yet have
 * a Spanish translation. Views has no native "missing translation" filter, so we
 * add a NOT EXISTS anti-join against the es row. The view itself filters to the
 * default-translation originals (default_langcode = 1); this removes the ones
 * already translated, leaving a true "needs Spanish" worklist that shrinks as
 * content is translated.
 */
function adrupalcouple_translate_views_query_alter(ViewExecutable $view, $query): void {
  if ($view->id() !== 'untranslated_content') {
    return;
  }
  if (!$query instanceof Sql) {
    return;
  }
  // Base table alias for a node view is node_field_data; exclude any node that
  // already has an 'es' translation row.
  $query->addWhereExpression(0,
    "NOT EXISTS (SELECT 1 FROM {node_field_data} adc_es WHERE adc_es.nid = node_field_data.nid AND adc_es.langcode = :adc_tlang)",
    [':adc_tlang' => 'es'],
  );
}
