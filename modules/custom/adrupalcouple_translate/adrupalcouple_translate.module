<?php

/**
 * @file
 * AI bulk-translation support for A Drupal Couple.
 */

declare(strict_types=1);

use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_query_alter().
 *
 * Restricts each "untranslated_*" worklist view to source entities that do NOT
 * yet have a Spanish translation. Views has no native "missing translation"
 * filter, so we add a NOT EXISTS anti-join against the es row. Each view filters
 * to the default-translation originals (default_langcode = 1); this removes the
 * ones already translated, leaving true "needs Spanish" worklists that shrink as
 * content is translated. The view's base-table alias equals the base-table name.
 */
function adrupalcouple_translate_views_query_alter(ViewExecutable $view, $query): void {
  // view id => [base table, id column].
  $map = [
    'untranslated_content' => ['node_field_data', 'nid'],
    'untranslated_terms' => ['taxonomy_term_field_data', 'tid'],
    'untranslated_blocks' => ['block_content_field_data', 'id'],
  ];
  if (!isset($map[$view->id()]) || !$query instanceof Sql) {
    return;
  }
  [$table, $id] = $map[$view->id()];
  $query->addWhereExpression(0,
    "NOT EXISTS (SELECT 1 FROM {{$table}} adc_es WHERE adc_es.{$id} = {$table}.{$id} AND adc_es.langcode = :adc_tlang)",
    [':adc_tlang' => 'es'],
  );
}
